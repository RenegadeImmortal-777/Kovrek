// Kovrek Tensor Compute Benchmark: 16x16 Tensor MatMul + ReLU pipeline
// Deterministic CPU tensor execution using native VM tensor kernels.

fn make_matrix(rows: Int, cols: Int, scale: Float) {
    let mat = [];
    let r = 0;
    while r < rows {
        let row = [];
        let c = 0;
        while c < cols {
            row.push(((r * cols + c) % 7 + 1) * scale);
            c = c + 1;
        }
        mat.push(row);
        r = r + 1;
    }
    return mat;
}

let a = tensor(make_matrix(16, 16, 0.25), false);
let b = tensor(make_matrix(16, 16, 0.125), false);

let out = tensor_relu(tensor_matmul(a, b));
let step = 0;
while step < 50 {
    out = tensor_relu(tensor_matmul(a, b));
    step = step + 1;
}

let shape = tensor_shape(out);
assert(shape == [16, 16]);
let vals = tensor_values(out);
assert(len(vals) == 256);
assert(vals[0] > 0.0);
