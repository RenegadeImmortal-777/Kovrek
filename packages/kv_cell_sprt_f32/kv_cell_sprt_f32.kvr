// kv_cell_sprt_f32: Cellular Systems Biology & Metabolic Flux — Wald Sequential Probability Ratio Test (f32 regime)
// Combinatorial Synthesis Index #12152 (Domain=cell, Kernel=sprt, Regime=f32)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 16384 {
        clamped = 16384;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 16384, "clamped <= 16384");
    return clamped;
}

fn compute_control_law(setpoint: Number, measured: Number, kp: Number, ki: Number, accum: Number) -> Map {
    let err = setpoint - measured;
    let next_accum = accum + err;
    let raw_u = kp * err + ki * next_accum;
    return {"control": raw_u, "error": err, "integral": next_accum, "max_limit": 16384};
}

fn package_metadata() -> Map {
    return {"name": "kv_cell_sprt_f32", "domain": "cell", "kernel": "sprt", "regime": "f32", "max_budget": 16384};
}
