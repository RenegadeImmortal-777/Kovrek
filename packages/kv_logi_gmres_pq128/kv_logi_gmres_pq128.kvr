// kv_logi_gmres_pq128: Vehicle Routing & Mixed-Integer Supply Chains — Arnoldi Krylov Residual Minimizer (pq128 regime)
// Combinatorial Synthesis Index #22288 (Domain=logi, Kernel=gmres, Regime=pq128)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 1280 {
        clamped = 1280;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 1280, "clamped <= 1280");
    return clamped;
}

fn filter_update(prior: Number, prior_var: Number, obs: Number, gain: Number) -> Map {
    let post = prior + gain * (obs - prior);
    let post_var = (1.0 - gain) * prior_var;
    return {"estimate": post, "variance": post_var, "gain": gain, "domain_scale": 500};
}

fn package_metadata() -> Map {
    return {"name": "kv_logi_gmres_pq128", "domain": "logi", "kernel": "gmres", "regime": "pq128", "max_budget": 1280};
}
