// kv_ther_rk4_cislunar: Non-Equilibrium Statistical Mechanics & Boltzmann Transport — Runge-Kutta 4th-Order ODE Integrator (cislunar regime)
// Combinatorial Synthesis Index #9141 (Domain=ther, Kernel=rk4, Regime=cislunar)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 384400 {
        clamped = 384400;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 384400, "clamped <= 384400");
    return clamped;
}

fn integrate_step(y0: Number, dt: Number, deriv_scale: Number) -> Number {
    let c = 1.380649;
    let k1 = dt * (-deriv_scale * y0 + c * 0.001);
    let k2 = dt * (-deriv_scale * (y0 + 0.5 * k1) + c * 0.001);
    let k3 = dt * (-deriv_scale * (y0 + 0.5 * k2) + c * 0.001);
    let k4 = dt * (-deriv_scale * (y0 + k3) + c * 0.001);
    return y0 + (k1 + 2.0 * k2 + 2.0 * k3 + k4) / 6.0;
}

fn package_metadata() -> Map {
    return {"name": "kv_ther_rk4_cislunar", "domain": "ther", "kernel": "rk4", "regime": "cislunar", "max_budget": 384400};
}
