// kv_atom_cusum_amb300k: Atomic, Nuclear & Particle Physics — Page Log-Likelihood Change-Point Detector (amb300k regime)
// Combinatorial Synthesis Index #9954 (Domain=atom, Kernel=cusum, Regime=amb300k)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 3000 {
        clamped = 3000;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 3000, "clamped <= 3000");
    return clamped;
}

fn filter_update(prior: Number, prior_var: Number, obs: Number, gain: Number) -> Map {
    let post = prior + gain * (obs - prior);
    let post_var = (1.0 - gain) * prior_var;
    return {"estimate": post, "variance": post_var, "gain": gain, "domain_scale": 137.036};
}

fn package_metadata() -> Map {
    return {"name": "kv_atom_cusum_amb300k", "domain": "atom", "kernel": "cusum", "regime": "amb300k", "max_budget": 3000};
}
