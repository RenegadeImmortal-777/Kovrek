// ============================================================================
// kvcrypto: Kovrek Standard Cryptography Library Package
// ============================================================================
// Production-ready native bindings (AES-256-GCM, RFC 8439 ChaCha20-Poly1305,
// RFC 5869 HKDF-SHA256, PBKDF2-SHA256, TOTP) paired with pure-Kovrek multi-
// paradigm, asymmetric, zero-knowledge, post-quantum lattice, threshold, and
// experimental physics file-protection primitives.
//
// Compatible with both file inclusion (`use "../packages/kvcrypto/kvcrypto.kvr";`)
// and registry imports (`use "kvcrypto"; let crypto = import_package("kvcrypto");`).
// ============================================================================

// Backwards-compatible v0.1.0 hash helper.
fn sha256_text(value: Any) -> String { return sha256(value); }

// Native constant-time KDF and AEAD ergonomic wrappers.
fn kdf_hkdf_sha256(ikm: String, salt: String, info: String, bytes: Int) -> String {
    return hkdf_sha256(ikm, salt, info, bytes);
}

fn chacha20_poly1305_seal(key: String, plaintext: String, aad: String) -> String {
    return chacha20_poly1305_encrypt(key, plaintext, aad);
}

fn chacha20_poly1305_open(key: String, ciphertext: String, aad: String) -> String {
    return chacha20_poly1305_decrypt(key, ciphertext, aad);
}

// Domain-parameter getters (pure functions so `import_package("kvcrypto")` needs no global vars).
fn kvc_pi() -> Float { return 3.141592653589793; }
