// kv_neur_astar_f64: Leaky Integrate-and-Fire Neuromorphic Synapses — Admissible Heuristic A* Frontier Evaluator (f64 regime)
// Combinatorial Synthesis Index #5465 (Domain=neur, Kernel=astar, Regime=f64)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 65536 {
        clamped = 65536;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 65536, "clamped <= 65536");
    return clamped;
}

fn filter_update(prior: Number, prior_var: Number, obs: Number, gain: Number) -> Map {
    let post = prior + gain * (obs - prior);
    let post_var = (1.0 - gain) * prior_var;
    return {"estimate": post, "variance": post_var, "gain": gain, "domain_scale": 70};
}

fn package_metadata() -> Map {
    return {"name": "kv_neur_astar_f64", "domain": "neur", "kernel": "astar", "regime": "f64", "max_budget": 65536};
}
