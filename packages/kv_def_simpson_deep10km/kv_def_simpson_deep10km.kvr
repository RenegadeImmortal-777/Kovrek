// kv_def_simpson_deep10km: Phased-Array Radar & Synthetic Aperture Sonar — Composite Simpson 1/3 Numerical Integrator (deep10km regime)
// Combinatorial Synthesis Index #18231 (Domain=def, Kernel=simpson, Regime=deep10km)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 100000 {
        clamped = 100000;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 100000, "clamped <= 100000");
    return clamped;
}

fn compute_control_law(setpoint: Number, measured: Number, kp: Number, ki: Number, accum: Number) -> Map {
    let err = setpoint - measured;
    let next_accum = accum + err;
    let raw_u = kp * err + ki * next_accum;
    return {"control": raw_u, "error": err, "integral": next_accum, "max_limit": 100000};
}

fn package_metadata() -> Map {
    return {"name": "kv_def_simpson_deep10km", "domain": "def", "kernel": "simpson", "regime": "deep10km", "max_budget": 100000};
}
