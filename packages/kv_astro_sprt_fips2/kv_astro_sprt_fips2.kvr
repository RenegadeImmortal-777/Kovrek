// kv_astro_sprt_fips2: Astrophysics & Relativistic Cosmology — Wald Sequential Probability Ratio Test (fips2 regime)
// Combinatorial Synthesis Index #19095 (Domain=astro, Kernel=sprt, Regime=fips2)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 32768 {
        clamped = 32768;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 32768, "clamped <= 32768");
    return clamped;
}

fn compute_control_law(setpoint: Number, measured: Number, kp: Number, ki: Number, accum: Number) -> Map {
    let err = setpoint - measured;
    let next_accum = accum + err;
    let raw_u = kp * err + ki * next_accum;
    return {"control": raw_u, "error": err, "integral": next_accum, "max_limit": 32768};
}

fn package_metadata() -> Map {
    return {"name": "kv_astro_sprt_fips2", "domain": "astro", "kernel": "sprt", "regime": "fips2", "max_budget": 32768};
}
