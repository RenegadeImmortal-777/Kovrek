// kv_gnss_legendre_q16: Multi-Constellation GNSS & Strapdown INS — 3-Point Gauss-Legendre Quadrature Rule (q16 regime)
// Combinatorial Synthesis Index #9222 (Domain=gnss, Kernel=legendre, Regime=q16)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 16384 {
        clamped = 16384;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 16384, "clamped <= 16384");
    return clamped;
}

fn filter_update(prior: Number, prior_var: Number, obs: Number, gain: Number) -> Map {
    let post = prior + gain * (obs - prior);
    let post_var = (1.0 - gain) * prior_var;
    return {"estimate": post, "variance": post_var, "gain": gain, "domain_scale": 20200};
}

fn package_metadata() -> Map {
    return {"name": "kv_gnss_legendre_q16", "domain": "gnss", "kernel": "legendre", "regime": "q16", "max_budget": 16384};
}
