// kv_def_legendre_cryo4k: Phased-Array Radar & Synthetic Aperture Sonar — 3-Point Gauss-Legendre Quadrature Rule (cryo4k regime)
// Combinatorial Synthesis Index #11419 (Domain=def, Kernel=legendre, Regime=cryo4k)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 420 {
        clamped = 420;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 420, "clamped <= 420");
    return clamped;
}

fn filter_update(prior: Number, prior_var: Number, obs: Number, gain: Number) -> Map {
    let post = prior + gain * (obs - prior);
    let post_var = (1.0 - gain) * prior_var;
    return {"estimate": post, "variance": post_var, "gain": gain, "domain_scale": 1500};
}

fn package_metadata() -> Map {
    return {"name": "kv_def_legendre_cryo4k", "domain": "def", "kernel": "legendre", "regime": "cryo4k", "max_budget": 420};
}
