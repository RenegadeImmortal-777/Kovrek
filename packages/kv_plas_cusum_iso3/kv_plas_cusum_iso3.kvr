// kv_plas_cusum_iso3: Magnetohydrodynamic Alfvén Waves & Stellarators — Page Log-Likelihood Change-Point Detector (iso3 regime)
// Combinatorial Synthesis Index #16678 (Domain=plas, Kernel=cusum, Regime=iso3)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 3000 {
        clamped = 3000;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 3000, "clamped <= 3000");
    return clamped;
}

fn filter_update(prior: Number, prior_var: Number, obs: Number, gain: Number) -> Map {
    let post = prior + gain * (obs - prior);
    let post_var = (1.0 - gain) * prior_var;
    return {"estimate": post, "variance": post_var, "gain": gain, "domain_scale": 10000};
}

fn package_metadata() -> Map {
    return {"name": "kv_plas_cusum_iso3", "domain": "plas", "kernel": "cusum", "regime": "iso3", "max_budget": 3000};
}
