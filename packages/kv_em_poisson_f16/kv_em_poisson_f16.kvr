// kv_em_poisson_f16: Computational Electromagnetics & FDTD Maxwell Solver — Successive Over-Relaxation Elliptic Kernel (f16 regime)
// Combinatorial Synthesis Index #19014 (Domain=em, Kernel=poisson, Regime=f16)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 2048 {
        clamped = 2048;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 2048, "clamped <= 2048");
    return clamped;
}

fn filter_update(prior: Number, prior_var: Number, obs: Number, gain: Number) -> Map {
    let post = prior + gain * (obs - prior);
    let post_var = (1.0 - gain) * prior_var;
    return {"estimate": post, "variance": post_var, "gain": gain, "domain_scale": 376.73};
}

fn package_metadata() -> Map {
    return {"name": "kv_em_poisson_f16", "domain": "em", "kernel": "poisson", "regime": "f16", "max_budget": 2048};
}
