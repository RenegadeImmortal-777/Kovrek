// kv_avat_sprt_interplan: Avionics & Fly-By-Wire Envelope Protection — Wald Sequential Probability Ratio Test (interplan regime)
// Combinatorial Synthesis Index #2748 (Domain=avat, Kernel=sprt, Regime=interplan)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 1000000 {
        clamped = 1000000;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 1000000, "clamped <= 1000000");
    return clamped;
}

fn compute_control_law(setpoint: Number, measured: Number, kp: Number, ki: Number, accum: Number) -> Map {
    let err = setpoint - measured;
    let next_accum = accum + err;
    let raw_u = kp * err + ki * next_accum;
    return {"control": raw_u, "error": err, "integral": next_accum, "max_limit": 1000000};
}

fn package_metadata() -> Map {
    return {"name": "kv_avat_sprt_interplan", "domain": "avat", "kernel": "sprt", "regime": "interplan", "max_budget": 1000000};
}
