// kv_meteo_bezier_byz3: Mesoscale Primitive-Equation Weather Forecasting — De Casteljau Cubic Bernstein Evaluator (byz3 regime)
// Combinatorial Synthesis Index #5744 (Domain=meteo, Kernel=bezier, Regime=byz3)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 900 {
        clamped = 900;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 900, "clamped <= 900");
    return clamped;
}

fn compute_control_law(setpoint: Number, measured: Number, kp: Number, ki: Number, accum: Number) -> Map {
    let err = setpoint - measured;
    let next_accum = accum + err;
    let raw_u = kp * err + ki * next_accum;
    return {"control": raw_u, "error": err, "integral": next_accum, "max_limit": 900};
}

fn package_metadata() -> Map {
    return {"name": "kv_meteo_bezier_byz3", "domain": "meteo", "kernel": "bezier", "regime": "byz3", "max_budget": 900};
}
