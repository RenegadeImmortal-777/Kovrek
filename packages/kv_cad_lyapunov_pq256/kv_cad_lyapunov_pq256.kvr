// kv_cad_lyapunov_pq256: Computational Geometry, NURBS & Solid Meshing — Benettin Tangent-Space Lyapunov Exponent (pq256 regime)
// Combinatorial Synthesis Index #23581 (Domain=cad, Kernel=lyapunov, Regime=pq256)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 2560 {
        clamped = 2560;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 2560, "clamped <= 2560");
    return clamped;
}

fn interpolate_geodesic(p0: Number, p1: Number, p2: Number, t: Number) -> Map {
    let u = t;
    if u < 0.0 { u = 0.0; }
    if u > 1.0 { u = 1.0; }
    let om = 1.0 - u;
    let quad_bezier = om * om * p0 + 2.0 * om * u * p1 + u * u * p2;
    return {"point": quad_bezier, "param_t": u, "tangent": 2.0 * om * (p1 - p0) + 2.0 * u * (p2 - p1)};
}

fn package_metadata() -> Map {
    return {"name": "kv_cad_lyapunov_pq256", "domain": "cad", "kernel": "lyapunov", "regime": "pq256", "max_budget": 2560};
}
