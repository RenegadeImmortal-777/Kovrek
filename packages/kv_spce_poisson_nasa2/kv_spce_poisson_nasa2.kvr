// kv_spce_poisson_nasa2: Deep-Space Optical Navigation & GCR Shielding — Successive Over-Relaxation Elliptic Kernel (nasa2 regime)
// Combinatorial Synthesis Index #19322 (Domain=spce, Kernel=poisson, Regime=nasa2)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 24000 {
        clamped = 24000;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 24000, "clamped <= 24000");
    return clamped;
}

fn filter_update(prior: Number, prior_var: Number, obs: Number, gain: Number) -> Map {
    let post = prior + gain * (obs - prior);
    let post_var = (1.0 - gain) * prior_var;
    return {"estimate": post, "variance": post_var, "gain": gain, "domain_scale": 149597870.7};
}

fn package_metadata() -> Map {
    return {"name": "kv_spce_poisson_nasa2", "domain": "spce", "kernel": "poisson", "regime": "nasa2", "max_budget": 24000};
}
