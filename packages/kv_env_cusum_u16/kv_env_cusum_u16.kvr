// kv_env_cusum_u16: Subsurface Hydrology & Contaminant Transport — Page Log-Likelihood Change-Point Detector (u16 regime)
// Combinatorial Synthesis Index #5516 (Domain=env, Kernel=cusum, Regime=u16)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 65535 {
        clamped = 65535;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 65535, "clamped <= 65535");
    return clamped;
}

fn filter_update(prior: Number, prior_var: Number, obs: Number, gain: Number) -> Map {
    let post = prior + gain * (obs - prior);
    let post_var = (1.0 - gain) * prior_var;
    return {"estimate": post, "variance": post_var, "gain": gain, "domain_scale": 9.80665};
}

fn package_metadata() -> Map {
    return {"name": "kv_env_cusum_u16", "domain": "env", "kernel": "cusum", "regime": "u16", "max_budget": 65535};
}
