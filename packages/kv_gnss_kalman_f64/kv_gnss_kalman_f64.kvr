// kv_gnss_kalman_f64: Multi-Constellation GNSS & Strapdown INS — Kalman Covariance & Innovation Filter (f64 regime)
// Combinatorial Synthesis Index #5582 (Domain=gnss, Kernel=kalman, Regime=f64)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 65536 {
        clamped = 65536;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 65536, "clamped <= 65536");
    return clamped;
}

fn filter_update(prior: Number, prior_var: Number, obs: Number, gain: Number) -> Map {
    let post = prior + gain * (obs - prior);
    let post_var = (1.0 - gain) * prior_var;
    return {"estimate": post, "variance": post_var, "gain": gain, "domain_scale": 20200};
}

fn package_metadata() -> Map {
    return {"name": "kv_gnss_kalman_f64", "domain": "gnss", "kernel": "kalman", "regime": "f64", "max_budget": 65536};
}
