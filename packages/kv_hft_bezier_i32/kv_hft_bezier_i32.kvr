// kv_hft_bezier_i32: Limit-Order-Book Microstructure & Latency Arbitrage — De Casteljau Cubic Bernstein Evaluator (i32 regime)
// Combinatorial Synthesis Index #9567 (Domain=hft, Kernel=bezier, Regime=i32)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 32768 {
        clamped = 32768;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 32768, "clamped <= 32768");
    return clamped;
}

fn compute_control_law(setpoint: Number, measured: Number, kp: Number, ki: Number, accum: Number) -> Map {
    let err = setpoint - measured;
    let next_accum = accum + err;
    let raw_u = kp * err + ki * next_accum;
    return {"control": raw_u, "error": err, "integral": next_accum, "max_limit": 32768};
}

fn package_metadata() -> Map {
    return {"name": "kv_hft_bezier_i32", "domain": "hft", "kernel": "bezier", "regime": "i32", "max_budget": 32768};
}
