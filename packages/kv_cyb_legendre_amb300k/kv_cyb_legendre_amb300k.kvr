// kv_cyb_legendre_amb300k: Zero-Trust Cyber-Physical Intrusion Detection — 3-Point Gauss-Legendre Quadrature Rule (amb300k regime)
// Combinatorial Synthesis Index #9837 (Domain=cyb, Kernel=legendre, Regime=amb300k)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 3000 {
        clamped = 3000;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 3000, "clamped <= 3000");
    return clamped;
}

fn filter_update(prior: Number, prior_var: Number, obs: Number, gain: Number) -> Map {
    let post = prior + gain * (obs - prior);
    let post_var = (1.0 - gain) * prior_var;
    return {"estimate": post, "variance": post_var, "gain": gain, "domain_scale": 256};
}

fn package_metadata() -> Map {
    return {"name": "kv_cyb_legendre_amb300k", "domain": "cyb", "kernel": "legendre", "regime": "amb300k", "max_budget": 3000};
}
