// kv_cyb_bezier_f16: Zero-Trust Cyber-Physical Intrusion Detection — De Casteljau Cubic Bernstein Evaluator (f16 regime)
// Combinatorial Synthesis Index #7809 (Domain=cyb, Kernel=bezier, Regime=f16)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 2048 {
        clamped = 2048;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 2048, "clamped <= 2048");
    return clamped;
}

fn compute_control_law(setpoint: Number, measured: Number, kp: Number, ki: Number, accum: Number) -> Map {
    let err = setpoint - measured;
    let next_accum = accum + err;
    let raw_u = kp * err + ki * next_accum;
    return {"control": raw_u, "error": err, "integral": next_accum, "max_limit": 2048};
}

fn package_metadata() -> Map {
    return {"name": "kv_cyb_bezier_f16", "domain": "cyb", "kernel": "bezier", "regime": "f16", "max_budget": 2048};
}
