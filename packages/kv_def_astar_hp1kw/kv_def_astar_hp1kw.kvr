// kv_def_astar_hp1kw: Phased-Array Radar & Synthetic Aperture Sonar — Admissible Heuristic A* Frontier Evaluator (hp1kw regime)
// Combinatorial Synthesis Index #19219 (Domain=def, Kernel=astar, Regime=hp1kw)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 50000 {
        clamped = 50000;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 50000, "clamped <= 50000");
    return clamped;
}

fn filter_update(prior: Number, prior_var: Number, obs: Number, gain: Number) -> Map {
    let post = prior + gain * (obs - prior);
    let post_var = (1.0 - gain) * prior_var;
    return {"estimate": post, "variance": post_var, "gain": gain, "domain_scale": 1500};
}

fn package_metadata() -> Map {
    return {"name": "kv_def_astar_hp1kw", "domain": "def", "kernel": "astar", "regime": "hp1kw", "max_budget": 50000};
}
