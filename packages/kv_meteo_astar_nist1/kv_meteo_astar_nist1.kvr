// kv_meteo_astar_nist1: Mesoscale Primitive-Equation Weather Forecasting — Admissible Heuristic A* Frontier Evaluator (nist1 regime)
// Combinatorial Synthesis Index #15572 (Domain=meteo, Kernel=astar, Regime=nist1)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 4096 {
        clamped = 4096;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 4096, "clamped <= 4096");
    return clamped;
}

fn filter_update(prior: Number, prior_var: Number, obs: Number, gain: Number) -> Map {
    let post = prior + gain * (obs - prior);
    let post_var = (1.0 - gain) * prior_var;
    return {"estimate": post, "variance": post_var, "gain": gain, "domain_scale": 1013.25};
}

fn package_metadata() -> Map {
    return {"name": "kv_meteo_astar_nist1", "domain": "meteo", "kernel": "astar", "regime": "nist1", "max_budget": 4096};
}
