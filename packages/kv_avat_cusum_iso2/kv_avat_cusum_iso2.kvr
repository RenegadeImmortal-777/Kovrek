// kv_avat_cusum_iso2: Avionics & Fly-By-Wire Envelope Protection — Page Log-Likelihood Change-Point Detector (iso2 regime)
// Combinatorial Synthesis Index #5296 (Domain=avat, Kernel=cusum, Regime=iso2)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 2000 {
        clamped = 2000;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 2000, "clamped <= 2000");
    return clamped;
}

fn filter_update(prior: Number, prior_var: Number, obs: Number, gain: Number) -> Map {
    let post = prior + gain * (obs - prior);
    let post_var = (1.0 - gain) * prior_var;
    return {"estimate": post, "variance": post_var, "gain": gain, "domain_scale": 250};
}

fn package_metadata() -> Map {
    return {"name": "kv_avat_cusum_iso2", "domain": "avat", "kernel": "cusum", "regime": "iso2", "max_budget": 2000};
}
