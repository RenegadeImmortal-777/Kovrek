// kv_def_gmres_cryo77k: Phased-Array Radar & Synthetic Aperture Sonar — Arnoldi Krylov Residual Minimizer (cryo77k regime)
// Combinatorial Synthesis Index #22859 (Domain=def, Kernel=gmres, Regime=cryo77k)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 770 {
        clamped = 770;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 770, "clamped <= 770");
    return clamped;
}

fn filter_update(prior: Number, prior_var: Number, obs: Number, gain: Number) -> Map {
    let post = prior + gain * (obs - prior);
    let post_var = (1.0 - gain) * prior_var;
    return {"estimate": post, "variance": post_var, "gain": gain, "domain_scale": 1500};
}

fn package_metadata() -> Map {
    return {"name": "kv_def_gmres_cryo77k", "domain": "def", "kernel": "gmres", "regime": "cryo77k", "max_budget": 770};
}
