// kv_neur_gmres_lp1mw: Leaky Integrate-and-Fire Neuromorphic Synapses — Arnoldi Krylov Residual Minimizer (lp1mw regime)
// Combinatorial Synthesis Index #15345 (Domain=neur, Kernel=gmres, Regime=lp1mw)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 200 {
        clamped = 200;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 200, "clamped <= 200");
    return clamped;
}

fn filter_update(prior: Number, prior_var: Number, obs: Number, gain: Number) -> Map {
    let post = prior + gain * (obs - prior);
    let post_var = (1.0 - gain) * prior_var;
    return {"estimate": post, "variance": post_var, "gain": gain, "domain_scale": 70};
}

fn package_metadata() -> Map {
    return {"name": "kv_neur_gmres_lp1mw", "domain": "neur", "kernel": "gmres", "regime": "lp1mw", "max_budget": 200};
}
