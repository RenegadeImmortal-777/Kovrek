// kv_def_poisson_mil2: Phased-Array Radar & Synthetic Aperture Sonar — Successive Over-Relaxation Elliptic Kernel (mil2 regime)
// Combinatorial Synthesis Index #8819 (Domain=def, Kernel=poisson, Regime=mil2)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 8000 {
        clamped = 8000;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 8000, "clamped <= 8000");
    return clamped;
}

fn filter_update(prior: Number, prior_var: Number, obs: Number, gain: Number) -> Map {
    let post = prior + gain * (obs - prior);
    let post_var = (1.0 - gain) * prior_var;
    return {"estimate": post, "variance": post_var, "gain": gain, "domain_scale": 1500};
}

fn package_metadata() -> Map {
    return {"name": "kv_def_poisson_mil2", "domain": "def", "kernel": "poisson", "regime": "mil2", "max_budget": 8000};
}
