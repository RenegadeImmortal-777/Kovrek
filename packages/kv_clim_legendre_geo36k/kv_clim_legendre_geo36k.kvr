// kv_clim_legendre_geo36k: Climate Dynamics & Radiative Forcing — 3-Point Gauss-Legendre Quadrature Rule (geo36k regime)
// Combinatorial Synthesis Index #15242 (Domain=clim, Kernel=legendre, Regime=geo36k)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 36000 {
        clamped = 36000;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 36000, "clamped <= 36000");
    return clamped;
}

fn filter_update(prior: Number, prior_var: Number, obs: Number, gain: Number) -> Map {
    let post = prior + gain * (obs - prior);
    let post_var = (1.0 - gain) * prior_var;
    return {"estimate": post, "variance": post_var, "gain": gain, "domain_scale": 1361};
}

fn package_metadata() -> Map {
    return {"name": "kv_clim_legendre_geo36k", "domain": "clim", "kernel": "legendre", "regime": "geo36k", "max_budget": 36000};
}
