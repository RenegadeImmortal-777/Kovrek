// kv_cad_poisson_ieee1: Computational Geometry, NURBS & Solid Meshing — Successive Over-Relaxation Elliptic Kernel (ieee1 regime)
// Combinatorial Synthesis Index #16509 (Domain=cad, Kernel=poisson, Regime=ieee1)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 500 {
        clamped = 500;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 500, "clamped <= 500");
    return clamped;
}

fn filter_update(prior: Number, prior_var: Number, obs: Number, gain: Number) -> Map {
    let post = prior + gain * (obs - prior);
    let post_var = (1.0 - gain) * prior_var;
    return {"estimate": post, "variance": post_var, "gain": gain, "domain_scale": 0.001};
}

fn package_metadata() -> Map {
    return {"name": "kv_cad_poisson_ieee1", "domain": "cad", "kernel": "poisson", "regime": "ieee1", "max_budget": 500};
}
