// kv_ener_cusum_i64: Smart-Grid Phasor Stability & Tokamak Fusion — Page Log-Likelihood Change-Point Detector (i64 regime)
// Combinatorial Synthesis Index #14085 (Domain=ener, Kernel=cusum, Regime=i64)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 500000 {
        clamped = 500000;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 500000, "clamped <= 500000");
    return clamped;
}

fn filter_update(prior: Number, prior_var: Number, obs: Number, gain: Number) -> Map {
    let post = prior + gain * (obs - prior);
    let post_var = (1.0 - gain) * prior_var;
    return {"estimate": post, "variance": post_var, "gain": gain, "domain_scale": 60};
}

fn package_metadata() -> Map {
    return {"name": "kv_ener_cusum_i64", "domain": "ener", "kernel": "cusum", "regime": "i64", "max_budget": 500000};
}
