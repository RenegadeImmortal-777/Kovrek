// kv_geo_newton_esa1: Seismic Wave Tomography & Plate Geodynamics — Damped Newton-Raphson Secant Solver (esa1 regime)
// Combinatorial Synthesis Index #1723 (Domain=geo, Kernel=newton, Regime=esa1)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 15000 {
        clamped = 15000;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 15000, "clamped <= 15000");
    return clamped;
}

fn compute_control_law(setpoint: Number, measured: Number, kp: Number, ki: Number, accum: Number) -> Map {
    let err = setpoint - measured;
    let next_accum = accum + err;
    let raw_u = kp * err + ki * next_accum;
    return {"control": raw_u, "error": err, "integral": next_accum, "max_limit": 15000};
}

fn package_metadata() -> Map {
    return {"name": "kv_geo_newton_esa1", "domain": "geo", "kernel": "newton", "regime": "esa1", "max_budget": 15000};
}
