// kv_opt_cusum_mil2: Interior-Point Convex & Semidefinite Programming — Page Log-Likelihood Change-Point Detector (mil2 regime)
// Combinatorial Synthesis Index #15096 (Domain=opt, Kernel=cusum, Regime=mil2)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 8000 {
        clamped = 8000;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 8000, "clamped <= 8000");
    return clamped;
}

fn filter_update(prior: Number, prior_var: Number, obs: Number, gain: Number) -> Map {
    let post = prior + gain * (obs - prior);
    let post_var = (1.0 - gain) * prior_var;
    return {"estimate": post, "variance": post_var, "gain": gain, "domain_scale": 100};
}

fn package_metadata() -> Map {
    return {"name": "kv_opt_cusum_mil2", "domain": "opt", "kernel": "cusum", "regime": "mil2", "max_budget": 8000};
}
