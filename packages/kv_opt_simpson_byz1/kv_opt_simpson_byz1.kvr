// kv_opt_simpson_byz1: Interior-Point Convex & Semidefinite Programming — Composite Simpson 1/3 Numerical Integrator (byz1 regime)
// Combinatorial Synthesis Index #23988 (Domain=opt, Kernel=simpson, Regime=byz1)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 300 {
        clamped = 300;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 300, "clamped <= 300");
    return clamped;
}

fn compute_control_law(setpoint: Number, measured: Number, kp: Number, ki: Number, accum: Number) -> Map {
    let err = setpoint - measured;
    let next_accum = accum + err;
    let raw_u = kp * err + ki * next_accum;
    return {"control": raw_u, "error": err, "integral": next_accum, "max_limit": 300};
}

fn package_metadata() -> Map {
    return {"name": "kv_opt_simpson_byz1", "domain": "opt", "kernel": "simpson", "regime": "byz1", "max_budget": 300};
}
