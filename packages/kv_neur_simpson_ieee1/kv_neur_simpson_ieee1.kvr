// kv_neur_simpson_ieee1: Leaky Integrate-and-Fire Neuromorphic Synapses — Composite Simpson 1/3 Numerical Integrator (ieee1 regime)
// Combinatorial Synthesis Index #23197 (Domain=neur, Kernel=simpson, Regime=ieee1)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 500 {
        clamped = 500;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 500, "clamped <= 500");
    return clamped;
}

fn compute_control_law(setpoint: Number, measured: Number, kp: Number, ki: Number, accum: Number) -> Map {
    let err = setpoint - measured;
    let next_accum = accum + err;
    let raw_u = kp * err + ki * next_accum;
    return {"control": raw_u, "error": err, "integral": next_accum, "max_limit": 500};
}

fn package_metadata() -> Map {
    return {"name": "kv_neur_simpson_ieee1", "domain": "neur", "kernel": "simpson", "regime": "ieee1", "max_budget": 500};
}
