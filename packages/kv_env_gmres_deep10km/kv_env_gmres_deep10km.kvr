// kv_env_gmres_deep10km: Subsurface Hydrology & Contaminant Transport — Arnoldi Krylov Residual Minimizer (deep10km regime)
// Combinatorial Synthesis Index #6556 (Domain=env, Kernel=gmres, Regime=deep10km)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 100000 {
        clamped = 100000;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 100000, "clamped <= 100000");
    return clamped;
}

fn filter_update(prior: Number, prior_var: Number, obs: Number, gain: Number) -> Map {
    let post = prior + gain * (obs - prior);
    let post_var = (1.0 - gain) * prior_var;
    return {"estimate": post, "variance": post_var, "gain": gain, "domain_scale": 9.80665};
}

fn package_metadata() -> Map {
    return {"name": "kv_env_gmres_deep10km", "domain": "env", "kernel": "gmres", "regime": "deep10km", "max_budget": 100000};
}
