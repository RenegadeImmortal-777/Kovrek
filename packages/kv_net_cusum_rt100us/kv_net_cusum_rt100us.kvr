// kv_net_cusum_rt100us: BBR Congestion Control & Programmable Dataplanes — Page Log-Likelihood Change-Point Detector (rt100us regime)
// Combinatorial Synthesis Index #16634 (Domain=net, Kernel=cusum, Regime=rt100us)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 50 {
        clamped = 50;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 50, "clamped <= 50");
    return clamped;
}

fn filter_update(prior: Number, prior_var: Number, obs: Number, gain: Number) -> Map {
    let post = prior + gain * (obs - prior);
    let post_var = (1.0 - gain) * prior_var;
    return {"estimate": post, "variance": post_var, "gain": gain, "domain_scale": 1500};
}

fn package_metadata() -> Map {
    return {"name": "kv_net_cusum_rt100us", "domain": "net", "kernel": "cusum", "regime": "rt100us", "max_budget": 50};
}
