// kv_cyb_cusum_pq256: Zero-Trust Cyber-Physical Intrusion Detection — Page Log-Likelihood Change-Point Detector (pq256 regime)
// Combinatorial Synthesis Index #20237 (Domain=cyb, Kernel=cusum, Regime=pq256)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 2560 {
        clamped = 2560;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 2560, "clamped <= 2560");
    return clamped;
}

fn filter_update(prior: Number, prior_var: Number, obs: Number, gain: Number) -> Map {
    let post = prior + gain * (obs - prior);
    let post_var = (1.0 - gain) * prior_var;
    return {"estimate": post, "variance": post_var, "gain": gain, "domain_scale": 256};
}

fn package_metadata() -> Map {
    return {"name": "kv_cyb_cusum_pq256", "domain": "cyb", "kernel": "cusum", "regime": "pq256", "max_budget": 2560};
}
