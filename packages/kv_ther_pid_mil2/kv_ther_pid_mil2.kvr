// kv_ther_pid_mil2: Non-Equilibrium Statistical Mechanics & Boltzmann Transport — Anti-Windup PID Feedback Controller (mil2 regime)
// Combinatorial Synthesis Index #10285 (Domain=ther, Kernel=pid, Regime=mil2)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 8000 {
        clamped = 8000;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 8000, "clamped <= 8000");
    return clamped;
}

fn compute_control_law(setpoint: Number, measured: Number, kp: Number, ki: Number, accum: Number) -> Map {
    let err = setpoint - measured;
    let next_accum = accum + err;
    let raw_u = kp * err + ki * next_accum;
    return {"control": raw_u, "error": err, "integral": next_accum, "max_limit": 8000};
}

fn package_metadata() -> Map {
    return {"name": "kv_ther_pid_mil2", "domain": "ther", "kernel": "pid", "regime": "mil2", "max_budget": 8000};
}
