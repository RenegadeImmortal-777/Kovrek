// kv_hft_bezier_hp1mw: Limit-Order-Book Microstructure & Latency Arbitrage — De Casteljau Cubic Bernstein Evaluator (hp1mw regime)
// Combinatorial Synthesis Index #18927 (Domain=hft, Kernel=bezier, Regime=hp1mw)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 250000 {
        clamped = 250000;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 250000, "clamped <= 250000");
    return clamped;
}

fn compute_control_law(setpoint: Number, measured: Number, kp: Number, ki: Number, accum: Number) -> Map {
    let err = setpoint - measured;
    let next_accum = accum + err;
    let raw_u = kp * err + ki * next_accum;
    return {"control": raw_u, "error": err, "integral": next_accum, "max_limit": 250000};
}

fn package_metadata() -> Map {
    return {"name": "kv_hft_bezier_hp1mw", "domain": "hft", "kernel": "bezier", "regime": "hp1mw", "max_budget": 250000};
}
