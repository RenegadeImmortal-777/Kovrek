// kv_chem_simpson_i32: Computational Chemistry & Molecular Dynamics — Composite Simpson 1/3 Numerical Integrator (i32 regime)
// Combinatorial Synthesis Index #15023 (Domain=chem, Kernel=simpson, Regime=i32)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 32768 {
        clamped = 32768;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 32768, "clamped <= 32768");
    return clamped;
}

fn compute_control_law(setpoint: Number, measured: Number, kp: Number, ki: Number, accum: Number) -> Map {
    let err = setpoint - measured;
    let next_accum = accum + err;
    let raw_u = kp * err + ki * next_accum;
    return {"control": raw_u, "error": err, "integral": next_accum, "max_limit": 32768};
}

fn package_metadata() -> Map {
    return {"name": "kv_chem_simpson_i32", "domain": "chem", "kernel": "simpson", "regime": "i32", "max_budget": 32768};
}
