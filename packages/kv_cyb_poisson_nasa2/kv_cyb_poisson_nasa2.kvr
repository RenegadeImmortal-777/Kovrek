// kv_cyb_poisson_nasa2: Zero-Trust Cyber-Physical Intrusion Detection — Successive Over-Relaxation Elliptic Kernel (nasa2 regime)
// Combinatorial Synthesis Index #7237 (Domain=cyb, Kernel=poisson, Regime=nasa2)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 24000 {
        clamped = 24000;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 24000, "clamped <= 24000");
    return clamped;
}

fn filter_update(prior: Number, prior_var: Number, obs: Number, gain: Number) -> Map {
    let post = prior + gain * (obs - prior);
    let post_var = (1.0 - gain) * prior_var;
    return {"estimate": post, "variance": post_var, "gain": gain, "domain_scale": 256};
}

fn package_metadata() -> Map {
    return {"name": "kv_cyb_poisson_nasa2", "domain": "cyb", "kernel": "poisson", "regime": "nasa2", "max_budget": 24000};
}
