// kv_bio_poisson_byz1: Bioinformatics, Genomics & Proteomics — Successive Over-Relaxation Elliptic Kernel (byz1 regime)
// Combinatorial Synthesis Index #5567 (Domain=bio, Kernel=poisson, Regime=byz1)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 300 {
        clamped = 300;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 300, "clamped <= 300");
    return clamped;
}

fn filter_update(prior: Number, prior_var: Number, obs: Number, gain: Number) -> Map {
    let post = prior + gain * (obs - prior);
    let post_var = (1.0 - gain) * prior_var;
    return {"estimate": post, "variance": post_var, "gain": gain, "domain_scale": 4};
}

fn package_metadata() -> Map {
    return {"name": "kv_bio_poisson_byz1", "domain": "bio", "kernel": "poisson", "regime": "byz1", "max_budget": 300};
}
