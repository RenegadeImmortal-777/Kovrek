// kv_flui_gmres_nasa2: Navier-Stokes Computational Fluid Dynamics — Arnoldi Krylov Residual Minimizer (nasa2 regime)
// Combinatorial Synthesis Index #1898 (Domain=flui, Kernel=gmres, Regime=nasa2)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 24000 {
        clamped = 24000;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 24000, "clamped <= 24000");
    return clamped;
}

fn filter_update(prior: Number, prior_var: Number, obs: Number, gain: Number) -> Map {
    let post = prior + gain * (obs - prior);
    let post_var = (1.0 - gain) * prior_var;
    return {"estimate": post, "variance": post_var, "gain": gain, "domain_scale": 1.225};
}

fn package_metadata() -> Map {
    return {"name": "kv_flui_gmres_nasa2", "domain": "flui", "kernel": "gmres", "regime": "nasa2", "max_budget": 24000};
}
