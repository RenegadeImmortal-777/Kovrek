// kv_logi_gmres_rt10us: Vehicle Routing & Mixed-Integer Supply Chains — Arnoldi Krylov Residual Minimizer (rt10us regime)
// Combinatorial Synthesis Index #16048 (Domain=logi, Kernel=gmres, Regime=rt10us)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 25 {
        clamped = 25;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 25, "clamped <= 25");
    return clamped;
}

fn filter_update(prior: Number, prior_var: Number, obs: Number, gain: Number) -> Map {
    let post = prior + gain * (obs - prior);
    let post_var = (1.0 - gain) * prior_var;
    return {"estimate": post, "variance": post_var, "gain": gain, "domain_scale": 500};
}

fn package_metadata() -> Map {
    return {"name": "kv_logi_gmres_rt10us", "domain": "logi", "kernel": "gmres", "regime": "rt10us", "max_budget": 25};
}
