// kv_cryo_bezier_geo36k: Cryogenics & Josephson Superconductivity — De Casteljau Cubic Bernstein Evaluator (geo36k regime)
// Combinatorial Synthesis Index #10138 (Domain=cryo, Kernel=bezier, Regime=geo36k)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 36000 {
        clamped = 36000;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 36000, "clamped <= 36000");
    return clamped;
}

fn compute_control_law(setpoint: Number, measured: Number, kp: Number, ki: Number, accum: Number) -> Map {
    let err = setpoint - measured;
    let next_accum = accum + err;
    let raw_u = kp * err + ki * next_accum;
    return {"control": raw_u, "error": err, "integral": next_accum, "max_limit": 36000};
}

fn package_metadata() -> Map {
    return {"name": "kv_cryo_bezier_geo36k", "domain": "cryo", "kernel": "bezier", "regime": "geo36k", "max_budget": 36000};
}
