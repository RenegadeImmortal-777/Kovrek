// kv_mat_cusum_lp1mw: Crystal Lattice Phonons & Density Functional Theory — Page Log-Likelihood Change-Point Detector (lp1mw regime)
// Combinatorial Synthesis Index #3319 (Domain=mat, Kernel=cusum, Regime=lp1mw)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 200 {
        clamped = 200;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 200, "clamped <= 200");
    return clamped;
}

fn filter_update(prior: Number, prior_var: Number, obs: Number, gain: Number) -> Map {
    let post = prior + gain * (obs - prior);
    let post_var = (1.0 - gain) * prior_var;
    return {"estimate": post, "variance": post_var, "gain": gain, "domain_scale": 0.529};
}

fn package_metadata() -> Map {
    return {"name": "kv_mat_cusum_lp1mw", "domain": "mat", "kernel": "cusum", "regime": "lp1mw", "max_budget": 200};
}
