// kv_meteo_poisson_nasa1: Mesoscale Primitive-Equation Weather Forecasting — Successive Over-Relaxation Elliptic Kernel (nasa1 regime)
// Combinatorial Synthesis Index #8292 (Domain=meteo, Kernel=poisson, Regime=nasa1)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 12000 {
        clamped = 12000;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 12000, "clamped <= 12000");
    return clamped;
}

fn filter_update(prior: Number, prior_var: Number, obs: Number, gain: Number) -> Map {
    let post = prior + gain * (obs - prior);
    let post_var = (1.0 - gain) * prior_var;
    return {"estimate": post, "variance": post_var, "gain": gain, "domain_scale": 1013.25};
}

fn package_metadata() -> Map {
    return {"name": "kv_meteo_poisson_nasa1", "domain": "meteo", "kernel": "poisson", "regime": "nasa1", "max_budget": 12000};
}
