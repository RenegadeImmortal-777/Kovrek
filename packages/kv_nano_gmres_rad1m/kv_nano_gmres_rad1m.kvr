// kv_nano_gmres_rad1m: Carbon Nanotube Ballistic Transport & Quantum Dots — Arnoldi Krylov Residual Minimizer (rad1m regime)
// Combinatorial Synthesis Index #1283 (Domain=nano, Kernel=gmres, Regime=rad1m)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 500000 {
        clamped = 500000;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 500000, "clamped <= 500000");
    return clamped;
}

fn filter_update(prior: Number, prior_var: Number, obs: Number, gain: Number) -> Map {
    let post = prior + gain * (obs - prior);
    let post_var = (1.0 - gain) * prior_var;
    return {"estimate": post, "variance": post_var, "gain": gain, "domain_scale": 1.602};
}

fn package_metadata() -> Map {
    return {"name": "kv_nano_gmres_rad1m", "domain": "nano", "kernel": "gmres", "regime": "rad1m", "max_budget": 500000};
}
