// kv_atom_sprt_rad1m: Atomic, Nuclear & Particle Physics — Wald Sequential Probability Ratio Test (rad1m regime)
// Combinatorial Synthesis Index #1166 (Domain=atom, Kernel=sprt, Regime=rad1m)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 500000 {
        clamped = 500000;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 500000, "clamped <= 500000");
    return clamped;
}

fn compute_control_law(setpoint: Number, measured: Number, kp: Number, ki: Number, accum: Number) -> Map {
    let err = setpoint - measured;
    let next_accum = accum + err;
    let raw_u = kp * err + ki * next_accum;
    return {"control": raw_u, "error": err, "integral": next_accum, "max_limit": 500000};
}

fn package_metadata() -> Map {
    return {"name": "kv_atom_sprt_rad1m", "domain": "atom", "kernel": "sprt", "regime": "rad1m", "max_budget": 500000};
}
