// kv_auto_kalman_mil1: Autonomous Vehicles & LiDAR Perception — Kalman Covariance & Innovation Filter (mil1 regime)
// Combinatorial Synthesis Index #21665 (Domain=auto, Kernel=kalman, Regime=mil1)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 4000 {
        clamped = 4000;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 4000, "clamped <= 4000");
    return clamped;
}

fn filter_update(prior: Number, prior_var: Number, obs: Number, gain: Number) -> Map {
    let post = prior + gain * (obs - prior);
    let post_var = (1.0 - gain) * prior_var;
    return {"estimate": post, "variance": post_var, "gain": gain, "domain_scale": 30};
}

fn package_metadata() -> Map {
    return {"name": "kv_auto_kalman_mil1", "domain": "auto", "kernel": "kalman", "regime": "mil1", "max_budget": 4000};
}
