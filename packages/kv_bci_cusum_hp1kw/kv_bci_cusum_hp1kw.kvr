// kv_bci_cusum_hp1kw: Brain-Computer Interfaces & Neural Spike Decoding — Page Log-Likelihood Change-Point Detector (hp1kw regime)
// Combinatorial Synthesis Index #13118 (Domain=bci, Kernel=cusum, Regime=hp1kw)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 50000 {
        clamped = 50000;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 50000, "clamped <= 50000");
    return clamped;
}

fn filter_update(prior: Number, prior_var: Number, obs: Number, gain: Number) -> Map {
    let post = prior + gain * (obs - prior);
    let post_var = (1.0 - gain) * prior_var;
    return {"estimate": post, "variance": post_var, "gain": gain, "domain_scale": 1000};
}

fn package_metadata() -> Map {
    return {"name": "kv_bci_cusum_hp1kw", "domain": "bci", "kernel": "cusum", "regime": "hp1kw", "max_budget": 50000};
}
