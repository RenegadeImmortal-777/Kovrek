// kv_env_legendre_fips1: Subsurface Hydrology & Contaminant Transport — 3-Point Gauss-Legendre Quadrature Rule (fips1 regime)
// Combinatorial Synthesis Index #7596 (Domain=env, Kernel=legendre, Regime=fips1)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 16384 {
        clamped = 16384;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 16384, "clamped <= 16384");
    return clamped;
}

fn filter_update(prior: Number, prior_var: Number, obs: Number, gain: Number) -> Map {
    let post = prior + gain * (obs - prior);
    let post_var = (1.0 - gain) * prior_var;
    return {"estimate": post, "variance": post_var, "gain": gain, "domain_scale": 9.80665};
}

fn package_metadata() -> Map {
    return {"name": "kv_env_legendre_fips1", "domain": "env", "kernel": "legendre", "regime": "fips1", "max_budget": 16384};
}
