// kv_mat_poisson_vac1pa: Crystal Lattice Phonons & Density Functional Theory — Successive Over-Relaxation Elliptic Kernel (vac1pa regime)
// Combinatorial Synthesis Index #2799 (Domain=mat, Kernel=poisson, Regime=vac1pa)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 100 {
        clamped = 100;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 100, "clamped <= 100");
    return clamped;
}

fn filter_update(prior: Number, prior_var: Number, obs: Number, gain: Number) -> Map {
    let post = prior + gain * (obs - prior);
    let post_var = (1.0 - gain) * prior_var;
    return {"estimate": post, "variance": post_var, "gain": gain, "domain_scale": 0.529};
}

fn package_metadata() -> Map {
    return {"name": "kv_mat_poisson_vac1pa", "domain": "mat", "kernel": "poisson", "regime": "vac1pa", "max_budget": 100};
}
