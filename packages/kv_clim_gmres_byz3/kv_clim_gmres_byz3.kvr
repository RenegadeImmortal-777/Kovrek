// kv_clim_gmres_byz3: Climate Dynamics & Radiative Forcing — Arnoldi Krylov Residual Minimizer (byz3 regime)
// Combinatorial Synthesis Index #11082 (Domain=clim, Kernel=gmres, Regime=byz3)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 900 {
        clamped = 900;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 900, "clamped <= 900");
    return clamped;
}

fn filter_update(prior: Number, prior_var: Number, obs: Number, gain: Number) -> Map {
    let post = prior + gain * (obs - prior);
    let post_var = (1.0 - gain) * prior_var;
    return {"estimate": post, "variance": post_var, "gain": gain, "domain_scale": 1361};
}

fn package_metadata() -> Map {
    return {"name": "kv_clim_gmres_byz3", "domain": "clim", "kernel": "gmres", "regime": "byz3", "max_budget": 900};
}
