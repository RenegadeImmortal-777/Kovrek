// kv_ener_gmres_u8: Smart-Grid Phasor Stability & Tokamak Fusion — Arnoldi Krylov Residual Minimizer (u8 regime)
// Combinatorial Synthesis Index #18245 (Domain=ener, Kernel=gmres, Regime=u8)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 255 {
        clamped = 255;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 255, "clamped <= 255");
    return clamped;
}

fn filter_update(prior: Number, prior_var: Number, obs: Number, gain: Number) -> Map {
    let post = prior + gain * (obs - prior);
    let post_var = (1.0 - gain) * prior_var;
    return {"estimate": post, "variance": post_var, "gain": gain, "domain_scale": 60};
}

fn package_metadata() -> Map {
    return {"name": "kv_ener_gmres_u8", "domain": "ener", "kernel": "gmres", "regime": "u8", "max_budget": 255};
}
