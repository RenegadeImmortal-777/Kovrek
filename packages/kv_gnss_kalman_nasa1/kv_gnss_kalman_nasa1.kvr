// kv_gnss_kalman_nasa1: Multi-Constellation GNSS & Strapdown INS — Kalman Covariance & Innovation Filter (nasa1 regime)
// Combinatorial Synthesis Index #8702 (Domain=gnss, Kernel=kalman, Regime=nasa1)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 12000 {
        clamped = 12000;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 12000, "clamped <= 12000");
    return clamped;
}

fn filter_update(prior: Number, prior_var: Number, obs: Number, gain: Number) -> Map {
    let post = prior + gain * (obs - prior);
    let post_var = (1.0 - gain) * prior_var;
    return {"estimate": post, "variance": post_var, "gain": gain, "domain_scale": 20200};
}

fn package_metadata() -> Map {
    return {"name": "kv_gnss_kalman_nasa1", "domain": "gnss", "kernel": "kalman", "regime": "nasa1", "max_budget": 12000};
}
