// kv_atom_astar_iso2: Atomic, Nuclear & Particle Physics — Admissible Heuristic A* Frontier Evaluator (iso2 regime)
// Combinatorial Synthesis Index #22954 (Domain=atom, Kernel=astar, Regime=iso2)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 2000 {
        clamped = 2000;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 2000, "clamped <= 2000");
    return clamped;
}

fn filter_update(prior: Number, prior_var: Number, obs: Number, gain: Number) -> Map {
    let post = prior + gain * (obs - prior);
    let post_var = (1.0 - gain) * prior_var;
    return {"estimate": post, "variance": post_var, "gain": gain, "domain_scale": 137.036};
}

fn package_metadata() -> Map {
    return {"name": "kv_atom_astar_iso2", "domain": "atom", "kernel": "astar", "regime": "iso2", "max_budget": 2000};
}
