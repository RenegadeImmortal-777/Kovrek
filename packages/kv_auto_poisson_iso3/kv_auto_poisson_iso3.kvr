// kv_auto_poisson_iso3: Autonomous Vehicles & LiDAR Perception — Successive Over-Relaxation Elliptic Kernel (iso3 regime)
// Combinatorial Synthesis Index #10225 (Domain=auto, Kernel=poisson, Regime=iso3)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 3000 {
        clamped = 3000;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 3000, "clamped <= 3000");
    return clamped;
}

fn filter_update(prior: Number, prior_var: Number, obs: Number, gain: Number) -> Map {
    let post = prior + gain * (obs - prior);
    let post_var = (1.0 - gain) * prior_var;
    return {"estimate": post, "variance": post_var, "gain": gain, "domain_scale": 30};
}

fn package_metadata() -> Map {
    return {"name": "kv_auto_poisson_iso3", "domain": "auto", "kernel": "poisson", "regime": "iso3", "max_budget": 3000};
}
