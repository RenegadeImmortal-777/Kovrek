// kv_db_gmres_hp1mw: LSM-Tree & B+Tree Transactional Storage Engines — Arnoldi Krylov Residual Minimizer (hp1mw regime)
// Combinatorial Synthesis Index #12708 (Domain=db, Kernel=gmres, Regime=hp1mw)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 250000 {
        clamped = 250000;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 250000, "clamped <= 250000");
    return clamped;
}

fn filter_update(prior: Number, prior_var: Number, obs: Number, gain: Number) -> Map {
    let post = prior + gain * (obs - prior);
    let post_var = (1.0 - gain) * prior_var;
    return {"estimate": post, "variance": post_var, "gain": gain, "domain_scale": 4096};
}

fn package_metadata() -> Map {
    return {"name": "kv_db_gmres_hp1mw", "domain": "db", "kernel": "gmres", "regime": "hp1mw", "max_budget": 250000};
}
