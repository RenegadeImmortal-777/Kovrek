// kv_phot_pid_ieee2: Kerr Nonlinear Fiber Solitons & Silicon Photonics — Anti-Windup PID Feedback Controller (ieee2 regime)
// Combinatorial Synthesis Index #5539 (Domain=phot, Kernel=pid, Regime=ieee2)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 2500 {
        clamped = 2500;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 2500, "clamped <= 2500");
    return clamped;
}

fn compute_control_law(setpoint: Number, measured: Number, kp: Number, ki: Number, accum: Number) -> Map {
    let err = setpoint - measured;
    let next_accum = accum + err;
    let raw_u = kp * err + ki * next_accum;
    return {"control": raw_u, "error": err, "integral": next_accum, "max_limit": 2500};
}

fn package_metadata() -> Map {
    return {"name": "kv_phot_pid_ieee2", "domain": "phot", "kernel": "pid", "regime": "ieee2", "max_budget": 2500};
}
