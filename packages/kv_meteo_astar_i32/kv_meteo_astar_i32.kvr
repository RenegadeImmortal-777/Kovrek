// kv_meteo_astar_i32: Mesoscale Primitive-Equation Weather Forecasting — Admissible Heuristic A* Frontier Evaluator (i32 regime)
// Combinatorial Synthesis Index #9332 (Domain=meteo, Kernel=astar, Regime=i32)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 32768 {
        clamped = 32768;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 32768, "clamped <= 32768");
    return clamped;
}

fn filter_update(prior: Number, prior_var: Number, obs: Number, gain: Number) -> Map {
    let post = prior + gain * (obs - prior);
    let post_var = (1.0 - gain) * prior_var;
    return {"estimate": post, "variance": post_var, "gain": gain, "domain_scale": 1013.25};
}

fn package_metadata() -> Map {
    return {"name": "kv_meteo_astar_i32", "domain": "meteo", "kernel": "astar", "regime": "i32", "max_budget": 32768};
}
