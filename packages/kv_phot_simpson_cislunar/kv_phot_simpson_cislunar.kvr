// kv_phot_simpson_cislunar: Kerr Nonlinear Fiber Solitons & Silicon Photonics — Composite Simpson 1/3 Numerical Integrator (cislunar regime)
// Combinatorial Synthesis Index #15419 (Domain=phot, Kernel=simpson, Regime=cislunar)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 384400 {
        clamped = 384400;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 384400, "clamped <= 384400");
    return clamped;
}

fn compute_control_law(setpoint: Number, measured: Number, kp: Number, ki: Number, accum: Number) -> Map {
    let err = setpoint - measured;
    let next_accum = accum + err;
    let raw_u = kp * err + ki * next_accum;
    return {"control": raw_u, "error": err, "integral": next_accum, "max_limit": 384400};
}

fn package_metadata() -> Map {
    return {"name": "kv_phot_simpson_cislunar", "domain": "phot", "kernel": "simpson", "regime": "cislunar", "max_budget": 384400};
}
