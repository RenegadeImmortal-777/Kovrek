// kv_mecha_gmres_iso2: Compliant Actuators & Soft Continuum Robotics — Arnoldi Krylov Residual Minimizer (iso2 regime)
// Combinatorial Synthesis Index #5941 (Domain=mecha, Kernel=gmres, Regime=iso2)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 2000 {
        clamped = 2000;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 2000, "clamped <= 2000");
    return clamped;
}

fn filter_update(prior: Number, prior_var: Number, obs: Number, gain: Number) -> Map {
    let post = prior + gain * (obs - prior);
    let post_var = (1.0 - gain) * prior_var;
    return {"estimate": post, "variance": post_var, "gain": gain, "domain_scale": 12};
}

fn package_metadata() -> Map {
    return {"name": "kv_mecha_gmres_iso2", "domain": "mecha", "kernel": "gmres", "regime": "iso2", "max_budget": 2000};
}
