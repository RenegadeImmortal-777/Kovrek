// kv_neur_chebyshev_geo36k: Leaky Integrate-and-Fire Neuromorphic Synapses — Clenshaw Recurrence Chebyshev Evaluator (geo36k regime)
// Combinatorial Synthesis Index #3333 (Domain=neur, Kernel=chebyshev, Regime=geo36k)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 36000 {
        clamped = 36000;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 36000, "clamped <= 36000");
    return clamped;
}

fn integrate_step(y0: Number, dt: Number, deriv_scale: Number) -> Number {
    let c = 70;
    let k1 = dt * (-deriv_scale * y0 + c * 0.001);
    let k2 = dt * (-deriv_scale * (y0 + 0.5 * k1) + c * 0.001);
    let k3 = dt * (-deriv_scale * (y0 + 0.5 * k2) + c * 0.001);
    let k4 = dt * (-deriv_scale * (y0 + k3) + c * 0.001);
    return y0 + (k1 + 2.0 * k2 + 2.0 * k3 + k4) / 6.0;
}

fn package_metadata() -> Map {
    return {"name": "kv_neur_chebyshev_geo36k", "domain": "neur", "kernel": "chebyshev", "regime": "geo36k", "max_budget": 36000};
}
