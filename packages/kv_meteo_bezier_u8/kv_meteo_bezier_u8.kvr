// kv_meteo_bezier_u8: Mesoscale Primitive-Equation Weather Forecasting — De Casteljau Cubic Bernstein Evaluator (u8 regime)
// Combinatorial Synthesis Index #24464 (Domain=meteo, Kernel=bezier, Regime=u8)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 255 {
        clamped = 255;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 255, "clamped <= 255");
    return clamped;
}

fn compute_control_law(setpoint: Number, measured: Number, kp: Number, ki: Number, accum: Number) -> Map {
    let err = setpoint - measured;
    let next_accum = accum + err;
    let raw_u = kp * err + ki * next_accum;
    return {"control": raw_u, "error": err, "integral": next_accum, "max_limit": 255};
}

fn package_metadata() -> Map {
    return {"name": "kv_meteo_bezier_u8", "domain": "meteo", "kernel": "bezier", "regime": "u8", "max_budget": 255};
}
