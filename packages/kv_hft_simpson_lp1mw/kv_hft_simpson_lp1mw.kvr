// kv_hft_simpson_lp1mw: Limit-Order-Book Microstructure & Latency Arbitrage — Composite Simpson 1/3 Numerical Integrator (lp1mw regime)
// Combinatorial Synthesis Index #15287 (Domain=hft, Kernel=simpson, Regime=lp1mw)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 200 {
        clamped = 200;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 200, "clamped <= 200");
    return clamped;
}

fn compute_control_law(setpoint: Number, measured: Number, kp: Number, ki: Number, accum: Number) -> Map {
    let err = setpoint - measured;
    let next_accum = accum + err;
    let raw_u = kp * err + ki * next_accum;
    return {"control": raw_u, "error": err, "integral": next_accum, "max_limit": 200};
}

fn package_metadata() -> Map {
    return {"name": "kv_hft_simpson_lp1mw", "domain": "hft", "kernel": "simpson", "regime": "lp1mw", "max_budget": 200};
}
