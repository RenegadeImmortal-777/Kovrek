// kv_flui_kalman_f32: Navier-Stokes Computational Fluid Dynamics — Kalman Covariance & Innovation Filter (f32 regime)
// Combinatorial Synthesis Index #18018 (Domain=flui, Kernel=kalman, Regime=f32)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 16384 {
        clamped = 16384;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 16384, "clamped <= 16384");
    return clamped;
}

fn filter_update(prior: Number, prior_var: Number, obs: Number, gain: Number) -> Map {
    let post = prior + gain * (obs - prior);
    let post_var = (1.0 - gain) * prior_var;
    return {"estimate": post, "variance": post_var, "gain": gain, "domain_scale": 1.225};
}

fn package_metadata() -> Map {
    return {"name": "kv_flui_kalman_f32", "domain": "flui", "kernel": "kalman", "regime": "f32", "max_budget": 16384};
}
