// kv_clim_poisson_amb300k: Climate Dynamics & Radiative Forcing — Successive Over-Relaxation Elliptic Kernel (amb300k regime)
// Combinatorial Synthesis Index #15762 (Domain=clim, Kernel=poisson, Regime=amb300k)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 3000 {
        clamped = 3000;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 3000, "clamped <= 3000");
    return clamped;
}

fn filter_update(prior: Number, prior_var: Number, obs: Number, gain: Number) -> Map {
    let post = prior + gain * (obs - prior);
    let post_var = (1.0 - gain) * prior_var;
    return {"estimate": post, "variance": post_var, "gain": gain, "domain_scale": 1361};
}

fn package_metadata() -> Map {
    return {"name": "kv_clim_poisson_amb300k", "domain": "clim", "kernel": "poisson", "regime": "amb300k", "max_budget": 3000};
}
