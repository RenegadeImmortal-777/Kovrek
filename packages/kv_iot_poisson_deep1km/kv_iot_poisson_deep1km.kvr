// kv_iot_poisson_deep1km: Ultra-Low-Power Mesh Sensor Telemetry — Successive Over-Relaxation Elliptic Kernel (deep1km regime)
// Combinatorial Synthesis Index #1217 (Domain=iot, Kernel=poisson, Regime=deep1km)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 10000 {
        clamped = 10000;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 10000, "clamped <= 10000");
    return clamped;
}

fn filter_update(prior: Number, prior_var: Number, obs: Number, gain: Number) -> Map {
    let post = prior + gain * (obs - prior);
    let post_var = (1.0 - gain) * prior_var;
    return {"estimate": post, "variance": post_var, "gain": gain, "domain_scale": 3.3};
}

fn package_metadata() -> Map {
    return {"name": "kv_iot_poisson_deep1km", "domain": "iot", "kernel": "poisson", "regime": "deep1km", "max_budget": 10000};
}
