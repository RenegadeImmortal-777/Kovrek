// kv_logi_pid_nist1: Vehicle Routing & Mixed-Integer Supply Chains — Anti-Windup PID Feedback Controller (nist1 regime)
// Combinatorial Synthesis Index #4660 (Domain=logi, Kernel=pid, Regime=nist1)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 4096 {
        clamped = 4096;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 4096, "clamped <= 4096");
    return clamped;
}

fn compute_control_law(setpoint: Number, measured: Number, kp: Number, ki: Number, accum: Number) -> Map {
    let err = setpoint - measured;
    let next_accum = accum + err;
    let raw_u = kp * err + ki * next_accum;
    return {"control": raw_u, "error": err, "integral": next_accum, "max_limit": 4096};
}

fn package_metadata() -> Map {
    return {"name": "kv_logi_pid_nist1", "domain": "logi", "kernel": "pid", "regime": "nist1", "max_budget": 4096};
}
