// kv_iot_simpson_hp1mw: Ultra-Low-Power Mesh Sensor Telemetry — Composite Simpson 1/3 Numerical Integrator (hp1mw regime)
// Combinatorial Synthesis Index #1269 (Domain=iot, Kernel=simpson, Regime=hp1mw)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 250000 {
        clamped = 250000;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 250000, "clamped <= 250000");
    return clamped;
}

fn compute_control_law(setpoint: Number, measured: Number, kp: Number, ki: Number, accum: Number) -> Map {
    let err = setpoint - measured;
    let next_accum = accum + err;
    let raw_u = kp * err + ki * next_accum;
    return {"control": raw_u, "error": err, "integral": next_accum, "max_limit": 250000};
}

fn package_metadata() -> Map {
    return {"name": "kv_iot_simpson_hp1mw", "domain": "iot", "kernel": "simpson", "regime": "hp1mw", "max_budget": 250000};
}
