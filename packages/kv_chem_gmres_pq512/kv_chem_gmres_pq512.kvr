// kv_chem_gmres_pq512: Computational Chemistry & Molecular Dynamics — Arnoldi Krylov Residual Minimizer (pq512 regime)
// Combinatorial Synthesis Index #19651 (Domain=chem, Kernel=gmres, Regime=pq512)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 5120 {
        clamped = 5120;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 5120, "clamped <= 5120");
    return clamped;
}

fn filter_update(prior: Number, prior_var: Number, obs: Number, gain: Number) -> Map {
    let post = prior + gain * (obs - prior);
    let post_var = (1.0 - gain) * prior_var;
    return {"estimate": post, "variance": post_var, "gain": gain, "domain_scale": 8.31446};
}

fn package_metadata() -> Map {
    return {"name": "kv_chem_gmres_pq512", "domain": "chem", "kernel": "gmres", "regime": "pq512", "max_budget": 5120};
}
