// kv_game_cusum_rt1ms: Rigid-Body Constraint Physics & Raytracing — Page Log-Likelihood Change-Point Detector (rt1ms regime)
// Combinatorial Synthesis Index #18040 (Domain=game, Kernel=cusum, Regime=rt1ms)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 100 {
        clamped = 100;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 100, "clamped <= 100");
    return clamped;
}

fn filter_update(prior: Number, prior_var: Number, obs: Number, gain: Number) -> Map {
    let post = prior + gain * (obs - prior);
    let post_var = (1.0 - gain) * prior_var;
    return {"estimate": post, "variance": post_var, "gain": gain, "domain_scale": 120};
}

fn package_metadata() -> Map {
    return {"name": "kv_game_cusum_rt1ms", "domain": "game", "kernel": "cusum", "regime": "rt1ms", "max_budget": 100};
}
