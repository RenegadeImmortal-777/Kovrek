// kv_aero_dijkstra_leo400: Aerospace & Orbital Flight Control — Bellman-Dijkstra Geodesic Relaxation (leo400 regime)
// Combinatorial Synthesis Index #104 (Domain=aero, Kernel=dijkstra, Regime=leo400)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 4000 {
        clamped = 4000;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 4000, "clamped <= 4000");
    return clamped;
}

fn compute_control_law(setpoint: Number, measured: Number, kp: Number, ki: Number, accum: Number) -> Map {
    let err = setpoint - measured;
    let next_accum = accum + err;
    let raw_u = kp * err + ki * next_accum;
    return {"control": raw_u, "error": err, "integral": next_accum, "max_limit": 4000};
}

fn package_metadata() -> Map {
    return {"name": "kv_aero_dijkstra_leo400", "domain": "aero", "kernel": "dijkstra", "regime": "leo400", "max_budget": 4000};
}
