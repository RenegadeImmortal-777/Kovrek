// kv_fhe_cusum_interplan: Ring-LWE Lattice & Homomorphic Cryptography — Page Log-Likelihood Change-Point Detector (interplan regime)
// Combinatorial Synthesis Index #14129 (Domain=fhe, Kernel=cusum, Regime=interplan)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 1000000 {
        clamped = 1000000;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 1000000, "clamped <= 1000000");
    return clamped;
}

fn filter_update(prior: Number, prior_var: Number, obs: Number, gain: Number) -> Map {
    let post = prior + gain * (obs - prior);
    let post_var = (1.0 - gain) * prior_var;
    return {"estimate": post, "variance": post_var, "gain": gain, "domain_scale": 8380417};
}

fn package_metadata() -> Map {
    return {"name": "kv_fhe_cusum_interplan", "domain": "fhe", "kernel": "cusum", "regime": "interplan", "max_budget": 1000000};
}
