// kv_nano_sprt_geo36k: Carbon Nanotube Ballistic Transport & Quantum Dots — Wald Sequential Probability Ratio Test (geo36k regime)
// Combinatorial Synthesis Index #16415 (Domain=nano, Kernel=sprt, Regime=geo36k)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 36000 {
        clamped = 36000;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 36000, "clamped <= 36000");
    return clamped;
}

fn compute_control_law(setpoint: Number, measured: Number, kp: Number, ki: Number, accum: Number) -> Map {
    let err = setpoint - measured;
    let next_accum = accum + err;
    let raw_u = kp * err + ki * next_accum;
    return {"control": raw_u, "error": err, "integral": next_accum, "max_limit": 36000};
}

fn package_metadata() -> Map {
    return {"name": "kv_nano_sprt_geo36k", "domain": "nano", "kernel": "sprt", "regime": "geo36k", "max_budget": 36000};
}
