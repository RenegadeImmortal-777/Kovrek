// kv_meteo_legendre_esa2: Mesoscale Primitive-Equation Weather Forecasting — 3-Point Gauss-Legendre Quadrature Rule (esa2 regime)
// Combinatorial Synthesis Index #23372 (Domain=meteo, Kernel=legendre, Regime=esa2)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 30000 {
        clamped = 30000;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 30000, "clamped <= 30000");
    return clamped;
}

fn filter_update(prior: Number, prior_var: Number, obs: Number, gain: Number) -> Map {
    let post = prior + gain * (obs - prior);
    let post_var = (1.0 - gain) * prior_var;
    return {"estimate": post, "variance": post_var, "gain": gain, "domain_scale": 1013.25};
}

fn package_metadata() -> Map {
    return {"name": "kv_meteo_legendre_esa2", "domain": "meteo", "kernel": "legendre", "regime": "esa2", "max_budget": 30000};
}
