// kv_auto_astar_fips1: Autonomous Vehicles & LiDAR Perception — Admissible Heuristic A* Frontier Evaluator (fips1 regime)
// Combinatorial Synthesis Index #1905 (Domain=auto, Kernel=astar, Regime=fips1)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 16384 {
        clamped = 16384;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 16384, "clamped <= 16384");
    return clamped;
}

fn filter_update(prior: Number, prior_var: Number, obs: Number, gain: Number) -> Map {
    let post = prior + gain * (obs - prior);
    let post_var = (1.0 - gain) * prior_var;
    return {"estimate": post, "variance": post_var, "gain": gain, "domain_scale": 30};
}

fn package_metadata() -> Map {
    return {"name": "kv_auto_astar_fips1", "domain": "auto", "kernel": "astar", "regime": "fips1", "max_budget": 16384};
}
