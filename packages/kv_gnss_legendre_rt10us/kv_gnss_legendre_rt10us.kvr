// kv_gnss_legendre_rt10us: Multi-Constellation GNSS & Strapdown INS — 3-Point Gauss-Legendre Quadrature Rule (rt10us regime)
// Combinatorial Synthesis Index #15462 (Domain=gnss, Kernel=legendre, Regime=rt10us)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 25 {
        clamped = 25;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 25, "clamped <= 25");
    return clamped;
}

fn filter_update(prior: Number, prior_var: Number, obs: Number, gain: Number) -> Map {
    let post = prior + gain * (obs - prior);
    let post_var = (1.0 - gain) * prior_var;
    return {"estimate": post, "variance": post_var, "gain": gain, "domain_scale": 20200};
}

fn package_metadata() -> Map {
    return {"name": "kv_gnss_legendre_rt10us", "domain": "gnss", "kernel": "legendre", "regime": "rt10us", "max_budget": 25};
}
