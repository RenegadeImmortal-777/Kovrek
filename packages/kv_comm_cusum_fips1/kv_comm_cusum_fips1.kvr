// kv_comm_cusum_fips1: 6G Terahertz OFDM & Channel Coding — Page Log-Likelihood Change-Point Detector (fips1 regime)
// Combinatorial Synthesis Index #7713 (Domain=comm, Kernel=cusum, Regime=fips1)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 16384 {
        clamped = 16384;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 16384, "clamped <= 16384");
    return clamped;
}

fn filter_update(prior: Number, prior_var: Number, obs: Number, gain: Number) -> Map {
    let post = prior + gain * (obs - prior);
    let post_var = (1.0 - gain) * prior_var;
    return {"estimate": post, "variance": post_var, "gain": gain, "domain_scale": 100};
}

fn package_metadata() -> Map {
    return {"name": "kv_comm_cusum_fips1", "domain": "comm", "kernel": "cusum", "regime": "fips1", "max_budget": 16384};
}
