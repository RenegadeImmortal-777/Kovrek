// kv_gnss_pid_byz3: Multi-Constellation GNSS & Strapdown INS — Anti-Windup PID Feedback Controller (byz3 regime)
// Combinatorial Synthesis Index #6154 (Domain=gnss, Kernel=pid, Regime=byz3)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 900 {
        clamped = 900;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 900, "clamped <= 900");
    return clamped;
}

fn compute_control_law(setpoint: Number, measured: Number, kp: Number, ki: Number, accum: Number) -> Map {
    let err = setpoint - measured;
    let next_accum = accum + err;
    let raw_u = kp * err + ki * next_accum;
    return {"control": raw_u, "error": err, "integral": next_accum, "max_limit": 900};
}

fn package_metadata() -> Map {
    return {"name": "kv_gnss_pid_byz3", "domain": "gnss", "kernel": "pid", "regime": "byz3", "max_budget": 900};
}
