// kv_chem_gmres_ieee2: Computational Chemistry & Molecular Dynamics — Arnoldi Krylov Residual Minimizer (ieee2 regime)
// Combinatorial Synthesis Index #10291 (Domain=chem, Kernel=gmres, Regime=ieee2)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 2500 {
        clamped = 2500;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 2500, "clamped <= 2500");
    return clamped;
}

fn filter_update(prior: Number, prior_var: Number, obs: Number, gain: Number) -> Map {
    let post = prior + gain * (obs - prior);
    let post_var = (1.0 - gain) * prior_var;
    return {"estimate": post, "variance": post_var, "gain": gain, "domain_scale": 8.31446};
}

fn package_metadata() -> Map {
    return {"name": "kv_chem_gmres_ieee2", "domain": "chem", "kernel": "gmres", "regime": "ieee2", "max_budget": 2500};
}
