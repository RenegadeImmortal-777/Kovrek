fn password_record(password: String, iterations: Number) -> Map {
    let salt=uuid_v4();
    let digest=pbkdf2_sha256(password,salt,iterations,32);
    return {"salt":salt,"iterations":iterations,"digest":digest};
}
fn verify_password(password: String, record: Map) -> Bool {
    let candidate=pbkdf2_sha256(password,record["salt"],record["iterations"],32);
    return constant_time_equal(candidate,record["digest"]);
}
fn api_key() -> String {
    return random_bytes_hex(32);
}
fn sign(secret: String, message: String) -> String { return hmac_sha256(secret,message); }
fn verify_signature(secret: String, message: String, signature: String) -> Bool {
    return constant_time_equal(hmac_sha256(secret,message),signature);
}

fn generate_totp_secret() -> String { return totp_secret(); }
fn totp_now(secret: String) -> String { return totp_code(secret); }
fn verify_totp(secret: String, code: String, window: Number) -> Bool {
    return totp_verify(secret, code, window);
}
fn encrypt_mfa_secret(master_key: String, secret: String) -> String {
    return aes_gcm_encrypt(master_key, secret, "mfa");
}
fn decrypt_mfa_secret(master_key: String, sealed: String) -> String {
    return aes_gcm_decrypt(master_key, sealed, "mfa");
}

fn generate_recovery_codes(count: Number) -> Map {
    let codes = [];
    let hashes = [];
    let i = 0;
    while i < count {
        let code = upper(random_bytes_hex(4)) + "-" + upper(random_bytes_hex(4));
        codes.push(code);
        hashes.push(sha256(code));
        i = i + 1;
    }
    return {"codes": codes, "hashes": hashes};
}

fn consume_recovery_code(code: String, stored_hashes: List) -> Map {
    let target = sha256(upper(trim(code)));
    let remaining = [];
    let matched = false;
    for h in stored_hashes {
        if (not matched) and constant_time_equal(h, target) {
            matched = true;
        } else {
            remaining.push(h);
        }
    }
    return {"ok": matched, "remaining_hashes": remaining};
}

fn csrf_token(secret: String, session_id: String, scope: String) -> String {
    return hmac_sha256(secret, "csrf:" + session_id + ":" + scope);
}
fn verify_csrf_token(secret: String, session_id: String, scope: String, candidate: String) -> Bool {
    return constant_time_equal(csrf_token(secret, session_id, scope), candidate);
}
fn has_scope(granted_scopes: List, required_scope: String) -> Bool {
    return contains(granted_scopes, "*") or contains(granted_scopes, required_scope);
}
