// kv_net_dijkstra_meo20k: BBR Congestion Control & Programmable Dataplanes — Bellman-Dijkstra Geodesic Relaxation (meo20k regime)
// Combinatorial Synthesis Index #11486 (Domain=net, Kernel=dijkstra, Regime=meo20k)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 20000 {
        clamped = 20000;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 20000, "clamped <= 20000");
    return clamped;
}

fn compute_control_law(setpoint: Number, measured: Number, kp: Number, ki: Number, accum: Number) -> Map {
    let err = setpoint - measured;
    let next_accum = accum + err;
    let raw_u = kp * err + ki * next_accum;
    return {"control": raw_u, "error": err, "integral": next_accum, "max_limit": 20000};
}

fn package_metadata() -> Map {
    return {"name": "kv_net_dijkstra_meo20k", "domain": "net", "kernel": "dijkstra", "regime": "meo20k", "max_budget": 20000};
}
