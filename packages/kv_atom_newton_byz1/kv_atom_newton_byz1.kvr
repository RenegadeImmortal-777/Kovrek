// kv_atom_newton_byz1: Atomic, Nuclear & Particle Physics — Damped Newton-Raphson Secant Solver (byz1 regime)
// Combinatorial Synthesis Index #24046 (Domain=atom, Kernel=newton, Regime=byz1)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 300 {
        clamped = 300;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 300, "clamped <= 300");
    return clamped;
}

fn compute_control_law(setpoint: Number, measured: Number, kp: Number, ki: Number, accum: Number) -> Map {
    let err = setpoint - measured;
    let next_accum = accum + err;
    let raw_u = kp * err + ki * next_accum;
    return {"control": raw_u, "error": err, "integral": next_accum, "max_limit": 300};
}

fn package_metadata() -> Map {
    return {"name": "kv_atom_newton_byz1", "domain": "atom", "kernel": "newton", "regime": "byz1", "max_budget": 300};
}
