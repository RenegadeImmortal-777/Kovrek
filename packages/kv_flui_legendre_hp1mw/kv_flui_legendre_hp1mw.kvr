// kv_flui_legendre_hp1mw: Navier-Stokes Computational Fluid Dynamics — 3-Point Gauss-Legendre Quadrature Rule (hp1mw regime)
// Combinatorial Synthesis Index #12298 (Domain=flui, Kernel=legendre, Regime=hp1mw)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 250000 {
        clamped = 250000;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 250000, "clamped <= 250000");
    return clamped;
}

fn filter_update(prior: Number, prior_var: Number, obs: Number, gain: Number) -> Map {
    let post = prior + gain * (obs - prior);
    let post_var = (1.0 - gain) * prior_var;
    return {"estimate": post, "variance": post_var, "gain": gain, "domain_scale": 1.225};
}

fn package_metadata() -> Map {
    return {"name": "kv_flui_legendre_hp1mw", "domain": "flui", "kernel": "legendre", "regime": "hp1mw", "max_budget": 250000};
}
