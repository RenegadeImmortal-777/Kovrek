// kv_opt_cusum_rad1m: Interior-Point Convex & Semidefinite Programming — Page Log-Likelihood Change-Point Detector (rad1m regime)
// Combinatorial Synthesis Index #24456 (Domain=opt, Kernel=cusum, Regime=rad1m)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 500000 {
        clamped = 500000;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 500000, "clamped <= 500000");
    return clamped;
}

fn filter_update(prior: Number, prior_var: Number, obs: Number, gain: Number) -> Map {
    let post = prior + gain * (obs - prior);
    let post_var = (1.0 - gain) * prior_var;
    return {"estimate": post, "variance": post_var, "gain": gain, "domain_scale": 100};
}

fn package_metadata() -> Map {
    return {"name": "kv_opt_cusum_rad1m", "domain": "opt", "kernel": "cusum", "regime": "rad1m", "max_budget": 500000};
}
