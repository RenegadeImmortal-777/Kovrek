// kv_grid_cusum_iso1: Exascale Topology-Aware Job Scheduling — Page Log-Likelihood Change-Point Detector (iso1 regime)
// Combinatorial Synthesis Index #18084 (Domain=grid, Kernel=cusum, Regime=iso1)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 1000 {
        clamped = 1000;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 1000, "clamped <= 1000");
    return clamped;
}

fn filter_update(prior: Number, prior_var: Number, obs: Number, gain: Number) -> Map {
    let post = prior + gain * (obs - prior);
    let post_var = (1.0 - gain) * prior_var;
    return {"estimate": post, "variance": post_var, "gain": gain, "domain_scale": 65536};
}

fn package_metadata() -> Map {
    return {"name": "kv_grid_cusum_iso1", "domain": "grid", "kernel": "cusum", "regime": "iso1", "max_budget": 1000};
}
