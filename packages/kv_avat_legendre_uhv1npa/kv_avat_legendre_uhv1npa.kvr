// kv_avat_legendre_uhv1npa: Avionics & Fly-By-Wire Envelope Protection — 3-Point Gauss-Legendre Quadrature Rule (uhv1npa regime)
// Combinatorial Synthesis Index #7376 (Domain=avat, Kernel=legendre, Regime=uhv1npa)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 10 {
        clamped = 10;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 10, "clamped <= 10");
    return clamped;
}

fn filter_update(prior: Number, prior_var: Number, obs: Number, gain: Number) -> Map {
    let post = prior + gain * (obs - prior);
    let post_var = (1.0 - gain) * prior_var;
    return {"estimate": post, "variance": post_var, "gain": gain, "domain_scale": 250};
}

fn package_metadata() -> Map {
    return {"name": "kv_avat_legendre_uhv1npa", "domain": "avat", "kernel": "legendre", "regime": "uhv1npa", "max_budget": 10};
}
