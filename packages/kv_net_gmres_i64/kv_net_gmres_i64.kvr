// kv_net_gmres_i64: BBR Congestion Control & Programmable Dataplanes — Arnoldi Krylov Residual Minimizer (i64 regime)
// Combinatorial Synthesis Index #14554 (Domain=net, Kernel=gmres, Regime=i64)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 500000 {
        clamped = 500000;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 500000, "clamped <= 500000");
    return clamped;
}

fn filter_update(prior: Number, prior_var: Number, obs: Number, gain: Number) -> Map {
    let post = prior + gain * (obs - prior);
    let post_var = (1.0 - gain) * prior_var;
    return {"estimate": post, "variance": post_var, "gain": gain, "domain_scale": 1500};
}

fn package_metadata() -> Map {
    return {"name": "kv_net_gmres_i64", "domain": "net", "kernel": "gmres", "regime": "i64", "max_budget": 500000};
}
