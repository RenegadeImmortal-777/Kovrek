// kv_cad_gmres_cislunar: Computational Geometry, NURBS & Solid Meshing — Arnoldi Krylov Residual Minimizer (cislunar regime)
// Combinatorial Synthesis Index #14949 (Domain=cad, Kernel=gmres, Regime=cislunar)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 384400 {
        clamped = 384400;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 384400, "clamped <= 384400");
    return clamped;
}

fn filter_update(prior: Number, prior_var: Number, obs: Number, gain: Number) -> Map {
    let post = prior + gain * (obs - prior);
    let post_var = (1.0 - gain) * prior_var;
    return {"estimate": post, "variance": post_var, "gain": gain, "domain_scale": 0.001};
}

fn package_metadata() -> Map {
    return {"name": "kv_cad_gmres_cislunar", "domain": "cad", "kernel": "gmres", "regime": "cislunar", "max_budget": 384400};
}
