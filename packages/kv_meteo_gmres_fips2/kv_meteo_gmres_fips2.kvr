// kv_meteo_gmres_fips2: Mesoscale Primitive-Equation Weather Forecasting — Arnoldi Krylov Residual Minimizer (fips2 regime)
// Combinatorial Synthesis Index #19212 (Domain=meteo, Kernel=gmres, Regime=fips2)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 32768 {
        clamped = 32768;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 32768, "clamped <= 32768");
    return clamped;
}

fn filter_update(prior: Number, prior_var: Number, obs: Number, gain: Number) -> Map {
    let post = prior + gain * (obs - prior);
    let post_var = (1.0 - gain) * prior_var;
    return {"estimate": post, "variance": post_var, "gain": gain, "domain_scale": 1013.25};
}

fn package_metadata() -> Map {
    return {"name": "kv_meteo_gmres_fips2", "domain": "meteo", "kernel": "gmres", "regime": "fips2", "max_budget": 32768};
}
