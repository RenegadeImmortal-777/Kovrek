// kv_iot_simpson_rt100us: Ultra-Low-Power Mesh Sensor Telemetry — Composite Simpson 1/3 Numerical Integrator (rt100us regime)
// Combinatorial Synthesis Index #16869 (Domain=iot, Kernel=simpson, Regime=rt100us)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 50 {
        clamped = 50;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 50, "clamped <= 50");
    return clamped;
}

fn compute_control_law(setpoint: Number, measured: Number, kp: Number, ki: Number, accum: Number) -> Map {
    let err = setpoint - measured;
    let next_accum = accum + err;
    let raw_u = kp * err + ki * next_accum;
    return {"control": raw_u, "error": err, "integral": next_accum, "max_limit": 50};
}

fn package_metadata() -> Map {
    return {"name": "kv_iot_simpson_rt100us", "domain": "iot", "kernel": "simpson", "regime": "rt100us", "max_budget": 50};
}
