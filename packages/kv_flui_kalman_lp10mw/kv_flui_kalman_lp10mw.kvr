// kv_flui_kalman_lp10mw: Navier-Stokes Computational Fluid Dynamics — Kalman Covariance & Innovation Filter (lp10mw regime)
// Combinatorial Synthesis Index #8658 (Domain=flui, Kernel=kalman, Regime=lp10mw)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 2000 {
        clamped = 2000;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 2000, "clamped <= 2000");
    return clamped;
}

fn filter_update(prior: Number, prior_var: Number, obs: Number, gain: Number) -> Map {
    let post = prior + gain * (obs - prior);
    let post_var = (1.0 - gain) * prior_var;
    return {"estimate": post, "variance": post_var, "gain": gain, "domain_scale": 1.225};
}

fn package_metadata() -> Map {
    return {"name": "kv_flui_kalman_lp10mw", "domain": "flui", "kernel": "kalman", "regime": "lp10mw", "max_budget": 2000};
}
