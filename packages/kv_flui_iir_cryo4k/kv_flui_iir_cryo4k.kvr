// kv_flui_iir_cryo4k: Navier-Stokes Computational Fluid Dynamics — Direct-Form-II Biquad IIR Resonator (cryo4k regime)
// Combinatorial Synthesis Index #21450 (Domain=flui, Kernel=iir, Regime=cryo4k)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 420 {
        clamped = 420;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 420, "clamped <= 420");
    return clamped;
}

fn interpolate_geodesic(p0: Number, p1: Number, p2: Number, t: Number) -> Map {
    let u = t;
    if u < 0.0 { u = 0.0; }
    if u > 1.0 { u = 1.0; }
    let om = 1.0 - u;
    let quad_bezier = om * om * p0 + 2.0 * om * u * p1 + u * u * p2;
    return {"point": quad_bezier, "param_t": u, "tangent": 2.0 * om * (p1 - p0) + 2.0 * u * (p2 - p1)};
}

fn package_metadata() -> Map {
    return {"name": "kv_flui_iir_cryo4k", "domain": "flui", "kernel": "iir", "regime": "cryo4k", "max_budget": 420};
}
