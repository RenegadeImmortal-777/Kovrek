// kv_bci_newton_i64: Brain-Computer Interfaces & Neural Spike Decoding — Damped Newton-Raphson Secant Solver (i64 regime)
// Combinatorial Synthesis Index #14730 (Domain=bci, Kernel=newton, Regime=i64)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 500000 {
        clamped = 500000;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 500000, "clamped <= 500000");
    return clamped;
}

fn compute_control_law(setpoint: Number, measured: Number, kp: Number, ki: Number, accum: Number) -> Map {
    let err = setpoint - measured;
    let next_accum = accum + err;
    let raw_u = kp * err + ki * next_accum;
    return {"control": raw_u, "error": err, "integral": next_accum, "max_limit": 500000};
}

fn package_metadata() -> Map {
    return {"name": "kv_bci_newton_i64", "domain": "bci", "kernel": "newton", "regime": "i64", "max_budget": 500000};
}
