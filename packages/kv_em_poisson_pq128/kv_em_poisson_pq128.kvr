// kv_em_poisson_pq128: Computational Electromagnetics & FDTD Maxwell Solver — Successive Over-Relaxation Elliptic Kernel (pq128 regime)
// Combinatorial Synthesis Index #15894 (Domain=em, Kernel=poisson, Regime=pq128)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 1280 {
        clamped = 1280;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 1280, "clamped <= 1280");
    return clamped;
}

fn filter_update(prior: Number, prior_var: Number, obs: Number, gain: Number) -> Map {
    let post = prior + gain * (obs - prior);
    let post_var = (1.0 - gain) * prior_var;
    return {"estimate": post, "variance": post_var, "gain": gain, "domain_scale": 376.73};
}

fn package_metadata() -> Map {
    return {"name": "kv_em_poisson_pq128", "domain": "em", "kernel": "poisson", "regime": "pq128", "max_budget": 1280};
}
