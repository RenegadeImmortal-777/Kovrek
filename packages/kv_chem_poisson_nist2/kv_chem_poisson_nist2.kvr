// kv_chem_poisson_nist2: Computational Chemistry & Molecular Dynamics — Successive Over-Relaxation Elliptic Kernel (nist2 regime)
// Combinatorial Synthesis Index #2491 (Domain=chem, Kernel=poisson, Regime=nist2)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 8192 {
        clamped = 8192;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 8192, "clamped <= 8192");
    return clamped;
}

fn filter_update(prior: Number, prior_var: Number, obs: Number, gain: Number) -> Map {
    let post = prior + gain * (obs - prior);
    let post_var = (1.0 - gain) * prior_var;
    return {"estimate": post, "variance": post_var, "gain": gain, "domain_scale": 8.31446};
}

fn package_metadata() -> Map {
    return {"name": "kv_chem_poisson_nist2", "domain": "chem", "kernel": "poisson", "regime": "nist2", "max_budget": 8192};
}
