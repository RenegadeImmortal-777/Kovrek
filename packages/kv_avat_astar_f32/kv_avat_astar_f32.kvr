// kv_avat_astar_f32: Avionics & Fly-By-Wire Envelope Protection — Admissible Heuristic A* Frontier Evaluator (f32 regime)
// Combinatorial Synthesis Index #5816 (Domain=avat, Kernel=astar, Regime=f32)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 16384 {
        clamped = 16384;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 16384, "clamped <= 16384");
    return clamped;
}

fn filter_update(prior: Number, prior_var: Number, obs: Number, gain: Number) -> Map {
    let post = prior + gain * (obs - prior);
    let post_var = (1.0 - gain) * prior_var;
    return {"estimate": post, "variance": post_var, "gain": gain, "domain_scale": 250};
}

fn package_metadata() -> Map {
    return {"name": "kv_avat_astar_f32", "domain": "avat", "kernel": "astar", "regime": "f32", "max_budget": 16384};
}
