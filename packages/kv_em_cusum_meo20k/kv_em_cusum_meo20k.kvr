// kv_em_cusum_meo20k: Computational Electromagnetics & FDTD Maxwell Solver — Page Log-Likelihood Change-Point Detector (meo20k regime)
// Combinatorial Synthesis Index #16414 (Domain=em, Kernel=cusum, Regime=meo20k)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 20000 {
        clamped = 20000;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 20000, "clamped <= 20000");
    return clamped;
}

fn filter_update(prior: Number, prior_var: Number, obs: Number, gain: Number) -> Map {
    let post = prior + gain * (obs - prior);
    let post_var = (1.0 - gain) * prior_var;
    return {"estimate": post, "variance": post_var, "gain": gain, "domain_scale": 376.73};
}

fn package_metadata() -> Map {
    return {"name": "kv_em_cusum_meo20k", "domain": "em", "kernel": "cusum", "regime": "meo20k", "max_budget": 20000};
}
