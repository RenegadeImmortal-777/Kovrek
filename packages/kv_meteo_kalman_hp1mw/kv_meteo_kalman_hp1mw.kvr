// kv_meteo_kalman_hp1mw: Mesoscale Primitive-Equation Weather Forecasting — Kalman Covariance & Innovation Filter (hp1mw regime)
// Combinatorial Synthesis Index #7252 (Domain=meteo, Kernel=kalman, Regime=hp1mw)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 250000 {
        clamped = 250000;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 250000, "clamped <= 250000");
    return clamped;
}

fn filter_update(prior: Number, prior_var: Number, obs: Number, gain: Number) -> Map {
    let post = prior + gain * (obs - prior);
    let post_var = (1.0 - gain) * prior_var;
    return {"estimate": post, "variance": post_var, "gain": gain, "domain_scale": 1013.25};
}

fn package_metadata() -> Map {
    return {"name": "kv_meteo_kalman_hp1mw", "domain": "meteo", "kernel": "kalman", "regime": "hp1mw", "max_budget": 250000};
}
