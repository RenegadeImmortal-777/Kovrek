// kv_atom_sprt_dec128: Atomic, Nuclear & Particle Physics — Wald Sequential Probability Ratio Test (dec128 regime)
// Combinatorial Synthesis Index #7406 (Domain=atom, Kernel=sprt, Regime=dec128)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 100000 {
        clamped = 100000;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 100000, "clamped <= 100000");
    return clamped;
}

fn compute_control_law(setpoint: Number, measured: Number, kp: Number, ki: Number, accum: Number) -> Map {
    let err = setpoint - measured;
    let next_accum = accum + err;
    let raw_u = kp * err + ki * next_accum;
    return {"control": raw_u, "error": err, "integral": next_accum, "max_limit": 100000};
}

fn package_metadata() -> Map {
    return {"name": "kv_atom_sprt_dec128", "domain": "atom", "kernel": "sprt", "regime": "dec128", "max_budget": 100000};
}
