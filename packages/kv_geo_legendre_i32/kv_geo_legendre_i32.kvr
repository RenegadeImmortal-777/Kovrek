// kv_geo_legendre_i32: Seismic Wave Tomography & Plate Geodynamics — 3-Point Gauss-Legendre Quadrature Rule (i32 regime)
// Combinatorial Synthesis Index #14671 (Domain=geo, Kernel=legendre, Regime=i32)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 32768 {
        clamped = 32768;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 32768, "clamped <= 32768");
    return clamped;
}

fn filter_update(prior: Number, prior_var: Number, obs: Number, gain: Number) -> Map {
    let post = prior + gain * (obs - prior);
    let post_var = (1.0 - gain) * prior_var;
    return {"estimate": post, "variance": post_var, "gain": gain, "domain_scale": 6371};
}

fn package_metadata() -> Map {
    return {"name": "kv_geo_legendre_i32", "domain": "geo", "kernel": "legendre", "regime": "i32", "max_budget": 32768};
}
