// kv_meteo_gmres_mil1: Mesoscale Primitive-Equation Weather Forecasting — Arnoldi Krylov Residual Minimizer (mil1 regime)
// Combinatorial Synthesis Index #16092 (Domain=meteo, Kernel=gmres, Regime=mil1)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 4000 {
        clamped = 4000;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 4000, "clamped <= 4000");
    return clamped;
}

fn filter_update(prior: Number, prior_var: Number, obs: Number, gain: Number) -> Map {
    let post = prior + gain * (obs - prior);
    let post_var = (1.0 - gain) * prior_var;
    return {"estimate": post, "variance": post_var, "gain": gain, "domain_scale": 1013.25};
}

fn package_metadata() -> Map {
    return {"name": "kv_meteo_gmres_mil1", "domain": "meteo", "kernel": "gmres", "regime": "mil1", "max_budget": 4000};
}
