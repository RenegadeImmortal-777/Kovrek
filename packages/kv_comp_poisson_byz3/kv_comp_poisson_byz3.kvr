// kv_comp_poisson_byz3: Compiler Abstract Interpretation & SSA Optimization — Successive Over-Relaxation Elliptic Kernel (byz3 regime)
// Combinatorial Synthesis Index #4864 (Domain=comp, Kernel=poisson, Regime=byz3)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 900 {
        clamped = 900;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 900, "clamped <= 900");
    return clamped;
}

fn filter_update(prior: Number, prior_var: Number, obs: Number, gain: Number) -> Map {
    let post = prior + gain * (obs - prior);
    let post_var = (1.0 - gain) * prior_var;
    return {"estimate": post, "variance": post_var, "gain": gain, "domain_scale": 64};
}

fn package_metadata() -> Map {
    return {"name": "kv_comp_poisson_byz3", "domain": "comp", "kernel": "poisson", "regime": "byz3", "max_budget": 900};
}
