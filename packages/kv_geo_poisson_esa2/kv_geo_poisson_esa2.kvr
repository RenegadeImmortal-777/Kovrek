// kv_geo_poisson_esa2: Seismic Wave Tomography & Plate Geodynamics — Successive Over-Relaxation Elliptic Kernel (esa2 regime)
// Combinatorial Synthesis Index #5831 (Domain=geo, Kernel=poisson, Regime=esa2)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 30000 {
        clamped = 30000;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 30000, "clamped <= 30000");
    return clamped;
}

fn filter_update(prior: Number, prior_var: Number, obs: Number, gain: Number) -> Map {
    let post = prior + gain * (obs - prior);
    let post_var = (1.0 - gain) * prior_var;
    return {"estimate": post, "variance": post_var, "gain": gain, "domain_scale": 6371};
}

fn package_metadata() -> Map {
    return {"name": "kv_geo_poisson_esa2", "domain": "geo", "kernel": "poisson", "regime": "esa2", "max_budget": 30000};
}
