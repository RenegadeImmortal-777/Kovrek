// kv_def_simpson_esa2: Phased-Array Radar & Synthetic Aperture Sonar — Composite Simpson 1/3 Numerical Integrator (esa2 regime)
// Combinatorial Synthesis Index #11991 (Domain=def, Kernel=simpson, Regime=esa2)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 30000 {
        clamped = 30000;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 30000, "clamped <= 30000");
    return clamped;
}

fn compute_control_law(setpoint: Number, measured: Number, kp: Number, ki: Number, accum: Number) -> Map {
    let err = setpoint - measured;
    let next_accum = accum + err;
    let raw_u = kp * err + ki * next_accum;
    return {"control": raw_u, "error": err, "integral": next_accum, "max_limit": 30000};
}

fn package_metadata() -> Map {
    return {"name": "kv_def_simpson_esa2", "domain": "def", "kernel": "simpson", "regime": "esa2", "max_budget": 30000};
}
