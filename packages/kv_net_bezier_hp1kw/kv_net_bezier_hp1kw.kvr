// kv_net_bezier_hp1kw: BBR Congestion Control & Programmable Dataplanes — De Casteljau Cubic Bernstein Evaluator (hp1kw regime)
// Combinatorial Synthesis Index #19806 (Domain=net, Kernel=bezier, Regime=hp1kw)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 50000 {
        clamped = 50000;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 50000, "clamped <= 50000");
    return clamped;
}

fn compute_control_law(setpoint: Number, measured: Number, kp: Number, ki: Number, accum: Number) -> Map {
    let err = setpoint - measured;
    let next_accum = accum + err;
    let raw_u = kp * err + ki * next_accum;
    return {"control": raw_u, "error": err, "integral": next_accum, "max_limit": 50000};
}

fn package_metadata() -> Map {
    return {"name": "kv_net_bezier_hp1kw", "domain": "net", "kernel": "bezier", "regime": "hp1kw", "max_budget": 50000};
}
