// kv_fin_kalman_interplan: Stochastic Calculus & Quantitative Derivatives — Kalman Covariance & Innovation Filter (interplan regime)
// Combinatorial Synthesis Index #20347 (Domain=fin, Kernel=kalman, Regime=interplan)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 1000000 {
        clamped = 1000000;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 1000000, "clamped <= 1000000");
    return clamped;
}

fn filter_update(prior: Number, prior_var: Number, obs: Number, gain: Number) -> Map {
    let post = prior + gain * (obs - prior);
    let post_var = (1.0 - gain) * prior_var;
    return {"estimate": post, "variance": post_var, "gain": gain, "domain_scale": 252};
}

fn package_metadata() -> Map {
    return {"name": "kv_fin_kalman_interplan", "domain": "fin", "kernel": "kalman", "regime": "interplan", "max_budget": 1000000};
}
