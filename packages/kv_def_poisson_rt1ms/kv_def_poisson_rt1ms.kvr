// kv_def_poisson_rt1ms: Phased-Array Radar & Synthetic Aperture Sonar — Successive Over-Relaxation Elliptic Kernel (rt1ms regime)
// Combinatorial Synthesis Index #11939 (Domain=def, Kernel=poisson, Regime=rt1ms)

@verify
fn verify_regime_budget(input_val: Int) -> Int {
    requires(input_val >= 0, "input_val >= 0");
    let clamped = input_val;
    if clamped > 100 {
        clamped = 100;
    }
    ensures(clamped >= 0, "clamped >= 0");
    ensures(clamped <= 100, "clamped <= 100");
    return clamped;
}

fn filter_update(prior: Number, prior_var: Number, obs: Number, gain: Number) -> Map {
    let post = prior + gain * (obs - prior);
    let post_var = (1.0 - gain) * prior_var;
    return {"estimate": post, "variance": post_var, "gain": gain, "domain_scale": 1500};
}

fn package_metadata() -> Map {
    return {"name": "kv_def_poisson_rt1ms", "domain": "def", "kernel": "poisson", "regime": "rt1ms", "max_budget": 100};
}
